// Round-robin lead assignment
async function assignLeadRoundRobin(leadId, queueName) {
  const queue = await LeadQueue.findOne({ 
    where: { name: queueName },
    include: [{ model: User, as: 'members' }]
  });
  
  // Get last assigned user
  const lastAssignment = await Lead.findOne({
    where: { queue_id: queue.id },
    order: [['assigned_at', 'DESC']],
    limit: 1
  });
  
  // Get next user in queue
  const lastIndex = lastAssignment 
    ? queue.members.findIndex(u => u.id === lastAssignment.owner_id)
    : -1;
  
  const nextIndex = (lastIndex + 1) % queue.members.length;
  const nextUser = queue.members[nextIndex];
  
  // Assign lead
  await Lead.update(
    { 
      owner_id: nextUser.id,
      assigned_at: new Date()
    },
    { where: { id: leadId } }
  );
  
  // Notify user
  await sendNotification(nextUser.id, `New lead assigned: ${lead.name}`);
}
