// Example: Calculate lead score whenever lead is created or updated
async function calculateLeadScore(leadId) {
  const lead = await Lead.findById(leadId);
  const scoringRules = await LeadScoreRule.findAll({ where: { is_active: true } });
  
  let score = 0;
  
  for (const rule of scoringRules) {
    if (evaluateCriteria(lead, rule.criteria)) {
      score += rule.points;
    }
  }
  
  // Apply score decay (reduce score for inactive leads)
  const daysSinceActivity = getDaysSince(lead.last_activity_at);
  if (daysSinceActivity > 30) {
    const weeksInactive = Math.floor(daysSinceActivity / 7);
    score -= (weeksInactive * 5); // -5 points per week
  }
  
  // Ensure score stays within 0-100
  score = Math.max(0, Math.min(100, score));
  
  // Determine grade
  let grade;
  if (score >= 80) grade = 'A';
  else if (score >= 60) grade = 'B';
  else if (score >= 40) grade = 'C';
  else grade = 'D';
  
  await lead.update({ lead_score: score, grade: grade });
  
  // Trigger workflow if score crosses threshold
  if (score >= 70 && lead.lead_status === 'new') {
    await assignToSalesRep(leadId);
  }
}
