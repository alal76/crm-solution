// Sync CRM events to Google Calendar
async function syncToGoogleCalendar(userId) {
  const user = await User.findById(userId);
  const oauth2Client = getGoogleOAuth2Client(user.google_refresh_token);
  
  const calendar = google.calendar({ version: 'v3', auth: oauth2Client });
  
  // Get events created/updated since last sync
  const events = await Event.findAll({
    where: {
      assigned_to_id: userId,
      updated_at: { [Op.gte]: user.last_calendar_sync }
    }
  });
  
  for (const event of events) {
    const googleEvent = {
      summary: event.subject,
      description: event.description,
      start: { dateTime: event.start_datetime },
      end: { dateTime: event.end_datetime },
      location: event.location
    };
    
    if (event.google_calendar_id) {
      // Update existing
      await calendar.events.update({
        calendarId: 'primary',
        eventId: event.google_calendar_id,
        resource: googleEvent
      });
    } else {
      // Create new
      const response = await calendar.events.insert({
        calendarId: 'primary',
        resource: googleEvent
      });
      
      await event.update({ google_calendar_id: response.data.id });
    }
  }
  
  await user.update({ last_calendar_sync: new Date() });
}
