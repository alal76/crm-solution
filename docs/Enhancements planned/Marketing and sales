// Trigger workflow on record change
async function executeWorkflows(objectType, action, recordId, oldValues, newValues) {
  const workflows = await WorkflowRule.findAll({
    where: {
      object_type: objectType,
      is_active: true,
      trigger_type: [action, 'created_or_updated']
    },
    include: [{ model: WorkflowAction, as: 'actions' }]
  });
  
  for (const workflow of workflows) {
    // Evaluate criteria
    if (evaluateCriteria(newValues, workflow.criteria)) {
      // Execute actions in order
      const sortedActions = workflow.actions.sort((a, b) => 
        a.execution_order - b.execution_order
      );
      
      for (const action of sortedActions) {
        await executeWorkflowAction(action, recordId, newValues);
      }
    }
  }
}

async function executeWorkflowAction(action, recordId, recordData) {
  switch (action.action_type) {
    case 'email_alert':
      await sendEmailAlert(action.action_config, recordData);
      break;
      
    case 'field_update':
      await updateRecordField(recordId, action.action_config);
      break;
      
    case 'task_creation':
      await createTask(action.action_config, recordId);
      break;
      
    case 'webhook':
      await triggerWebhook(action.action_config, recordData);
      break;
  }
}
