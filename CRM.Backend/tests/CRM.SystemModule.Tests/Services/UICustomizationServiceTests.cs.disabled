using CRM.Core.Entities;
using CRM.Core.Interfaces;
using CRM.Infrastructure.Services;
using Microsoft.Extensions.Logging;
using Moq;
using Xunit;

namespace CRM.SystemModule.Tests.Services;

/// <summary>
/// Unit tests for UICustomizationService.
/// Tests UI customization functionality.
/// </summary>
public class UICustomizationServiceTests
{
    private readonly Mock<ICrmDbContext> _dbContextMock;
    private readonly Mock<ILogger<UICustomizationService>> _loggerMock;
    private readonly UICustomizationService _service;

    public UICustomizationServiceTests()
    {
        _dbContextMock = new Mock<ICrmDbContext>();
        _loggerMock = new Mock<ILogger<UICustomizationService>>();
        _service = new UICustomizationService(_dbContextMock.Object, _loggerMock.Object);
    }

    [Fact]
    public async Task GetCustomizationAsync_ReturnsValidCustomization()
    {
        // Arrange & Act
        var result = await _service.GetCustomizationAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task UpdateCustomizationAsync_UpdatesSettings()
    {
        // Arrange
        var customization = new { Theme = "Dark", Language = "en" };

        // Act
        await _service.UpdateCustomizationAsync(customization);

        // Assert - Verify no error is thrown
        Assert.True(true);
    }

    [Fact]
    public async Task GetAvailableThemesAsync_ReturnsThemes()
    {
        // Arrange & Act
        var result = await _service.GetAvailableThemesAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task ApplyThemeAsync_AppliesTheme()
    {
        // Arrange
        var themeName = "Dark";

        // Act
        await _service.ApplyThemeAsync(themeName);

        // Assert - Verify no error is thrown
        Assert.True(true);
    }

    [Fact]
    public async Task ResetToDefaultAsync_ResetsCustomization()
    {
        // Arrange & Act
        await _service.ResetToDefaultAsync();

        // Assert - Verify no error is thrown
        Assert.True(true);
    }
}
