using CRM.Core.Entities;
using CRM.Core.Interfaces;
using CRM.Infrastructure.Services;
using Microsoft.Extensions.Logging;
using Moq;
using Xunit;

namespace CRM.SystemModule.Tests.Services;

/// <summary>
/// Unit tests for PerformanceMonitoringService.
/// Tests system performance monitoring functionality.
/// </summary>
public class PerformanceMonitoringServiceTests
{
    private readonly Mock<ICrmDbContext> _dbContextMock;
    private readonly Mock<ILogger<PerformanceMonitoringService>> _loggerMock;
    private readonly PerformanceMonitoringService _service;

    public PerformanceMonitoringServiceTests()
    {
        _dbContextMock = new Mock<ICrmDbContext>();
        _loggerMock = new Mock<ILogger<PerformanceMonitoringService>>();
        _service = new PerformanceMonitoringService(_dbContextMock.Object, _loggerMock.Object);
    }

    [Fact]
    public async Task RecordMetricAsync_StoresMetric()
    {
        // Arrange
        var metricName = "API_Response_Time";
        var value = 150.5;

        // Act
        await _service.RecordMetricAsync(metricName, value);

        // Assert - Verify no error is thrown
        Assert.True(true);
    }

    [Fact]
    public async Task GetMetricsAsync_ReturnsMetrics()
    {
        // Arrange & Act
        var result = await _service.GetMetricsAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task GetAverageResponseTimeAsync_ReturnsValidValue()
    {
        // Arrange & Act
        var result = await _service.GetAverageResponseTimeAsync();

        // Assert
        Assert.True(result >= 0);
    }

    [Fact]
    public async Task GetSlowQueriesAsync_ReturnsSlowQueries()
    {
        // Arrange & Act
        var result = await _service.GetSlowQueriesAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task GetCacheHitRateAsync_ReturnsValidValue()
    {
        // Arrange & Act
        var result = await _service.GetCacheHitRateAsync();

        // Assert
        Assert.True(result >= 0 && result <= 100);
    }
}
