using CRM.Core.Entities;
using CRM.Core.Interfaces;
using CRM.Infrastructure.Services;
using Microsoft.Extensions.Logging;
using Moq;
using Xunit;

namespace CRM.SystemModule.Tests.Services;

/// <summary>
/// Unit tests for AdminDashboardService.
/// Tests dashboard functionality for admin users.
/// </summary>
public class AdminDashboardServiceTests
{
    private readonly Mock<ICrmDbContext> _dbContextMock;
    private readonly Mock<ILogger<AdminDashboardService>> _loggerMock;
    private readonly AdminDashboardService _service;

    public AdminDashboardServiceTests()
    {
        _dbContextMock = new Mock<ICrmDbContext>();
        _loggerMock = new Mock<ILogger<AdminDashboardService>>();
        _service = new AdminDashboardService(_dbContextMock.Object, _loggerMock.Object);
    }

    [Fact]
    public async Task GetDashboardSummaryAsync_ReturnsValidSummary()
    {
        // Arrange
        var users = new List<User>
        {
            new User 
            { 
                Id = 1, 
                Email = "test@example.com",
                Username = "testuser",
                FirstName = "Test",
                LastName = "User",
                Role = 1,
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            }
        };

        var userMock = users.CreateMockDbSet();
        _dbContextMock.Setup(x => x.Users).Returns(userMock.Object);

        // Act
        var result = await _service.GetDashboardSummaryAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task GetSystemHealthAsync_ReturnsHealthStatus()
    {
        // Arrange & Act
        var result = await _service.GetSystemHealthAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task GetUserStatisticsAsync_ReturnsValidStatistics()
    {
        // Arrange
        var users = new List<User>
        {
            new User 
            { 
                Id = 1, 
                Email = "test1@example.com",
                Username = "user1",
                FirstName = "Test",
                LastName = "One",
                Role = 1,
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            },
            new User 
            { 
                Id = 2, 
                Email = "test2@example.com",
                Username = "user2",
                FirstName = "Test",
                LastName = "Two",
                Role = 2,
                IsActive = false,
                CreatedAt = DateTime.UtcNow
            }
        };

        var userMock = users.CreateMockDbSet();
        _dbContextMock.Setup(x => x.Users).Returns(userMock.Object);

        // Act
        var result = await _service.GetUserStatisticsAsync();

        // Assert
        Assert.NotNull(result);
    }

    [Fact]
    public async Task GetAuditLogAsync_ReturnsValidAuditLog()
    {
        // Arrange & Act
        var result = await _service.GetAuditLogAsync();

        // Assert
        Assert.NotNull(result);
    }
}
