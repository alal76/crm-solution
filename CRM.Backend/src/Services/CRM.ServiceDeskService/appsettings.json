{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Kestrel": { "Endpoints": { "Http": { "Url": "http://0.0.0.0:5005" } } },
  "ConnectionStrings": { "DefaultConnection": "${DB_CONNECTION_STRING:}" },
  "Jwt": {
    "Secret": "${JWT_SECRET:DEVELOPMENT_ONLY_CHANGE_IN_PRODUCTION_32CHARS!}",
    "Issuer": "${JWT_ISSUER:CRM.Api}",
    "Audience": "${JWT_AUDIENCE:CRM.Client}",
    "ExpirationMinutes": 60
  },
  "JwtSettings": { "Key": "${JWT_SECRET:DEVELOPMENT_ONLY_CHANGE_IN_PRODUCTION_32CHARS!}", "Issuer": "${JWT_ISSUER:CRM.Api}", "Audience": "${JWT_AUDIENCE:CRM.Client}" }
}
