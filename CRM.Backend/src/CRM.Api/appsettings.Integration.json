{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": true,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "CRM.Infrastructure.Services": "Debug",
        "CRM.Api.Middleware": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/integration-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/integration-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [API] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  },
  "DetailedErrors": false,
  "EnableSensitiveDataLogging": false,
  "BuildType": "integration",
  "Features": {
    "EnableVerboseLogging": false,
    "EnableRequestResponseLogging": true,
    "EnableSqlQueryLogging": false,
    "EnablePerformanceMetrics": true,
    "EnableStackTraces": false,
    "EnableApiLogging": true,
    "EnableMiddlewareLogging": true,
    "EnableExternalApiLogging": true
  },
  "Integration": {
    "LogHttpRequests": true,
    "LogHttpResponses": true,
    "LogHeaders": true,
    "EnableRetryLogging": true,
    "EnableCircuitBreakerLogging": true
  }
}
