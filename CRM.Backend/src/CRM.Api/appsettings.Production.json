{
  "DatabaseProvider": "mariadb",
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "CRMApp",
    "Audience": "CRMUsers",
    "ExpirationMinutes": 60
  },
  "OAuth": {
    "Google": { 
      "ClientId": "${OAUTH_GOOGLE_CLIENT_ID}", 
      "ClientSecret": "${OAUTH_GOOGLE_CLIENT_SECRET}" 
    },
    "GitHub": { 
      "ClientId": "${OAUTH_GITHUB_CLIENT_ID}", 
      "ClientSecret": "${OAUTH_GITHUB_CLIENT_SECRET}" 
    },
    "Microsoft": { 
      "ClientId": "${OAUTH_MICROSOFT_CLIENT_ID}", 
      "ClientSecret": "${OAUTH_MICROSOFT_CLIENT_SECRET}" 
    }
  },
  "AllowedOrigins": "${ALLOWED_ORIGINS}",
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "CRM": "Information"
    }
  },
  "Instrumentation": {
    "Enabled": true,
    "VerboseLogging": false,
    "LogRequests": true,
    "LogResponses": false,
    "LogDatabaseQueries": false,
    "LogPerformanceMetrics": true,
    "SlowRequestThresholdMs": 2000,
    "SlowQueryThresholdMs": 500
  },
  "FeatureFlags": {
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableDeveloperExceptionPage": false,
    "EnableSensitiveDataLogging": false
  },
  
  "FeatureManagement": {
    "UseExternalChat": "${USE_EXTERNAL_CHAT:false}",
    "UseExternalSearch": "${USE_EXTERNAL_SEARCH:false}",
    "UseExternalNotifications": "${USE_EXTERNAL_NOTIFICATIONS:false}",
    "UseExternalAnalytics": "${USE_EXTERNAL_ANALYTICS:false}",
    "UseExternalSignatures": "${USE_EXTERNAL_SIGNATURES:false}",
    "UseExternalAI": "${USE_EXTERNAL_AI:true}",
    "UseExternalIntegrations": "${USE_EXTERNAL_INTEGRATIONS:false}",
    "EnableITSM": "${ENABLE_ITSM:true}",
    "EnableMarketing": "${ENABLE_MARKETING:true}",
    "EnableCustomerPortal": "${ENABLE_CUSTOMER_PORTAL:false}",
    "EnablePartnerPortal": "${ENABLE_PARTNER_PORTAL:false}",
    "EnableKnowledgeBase": "${ENABLE_KNOWLEDGE_BASE:true}",
    "NewSearchExperience": "${NEW_SEARCH_EXPERIENCE:false}",
    "AIAssistant": "${AI_ASSISTANT:true}",
    "RealTimeNotifications": "${REALTIME_NOTIFICATIONS:true}",
    "AdvancedWorkflows": "${ADVANCED_WORKFLOWS:true}"
  },
  
  "Providers": {
    "Chat": {
      "Type": "${PROVIDER_CHAT_TYPE:BuiltIn}",
      "Chatwoot": {
        "BaseUrl": "${CHATWOOT_BASE_URL}",
        "ApiKey": "${CHATWOOT_API_KEY}",
        "AccountId": "${CHATWOOT_ACCOUNT_ID:1}",
        "InboxId": "${CHATWOOT_INBOX_ID:1}"
      }
    },
    "Search": {
      "Type": "${PROVIDER_SEARCH_TYPE:BuiltIn}",
      "Meilisearch": {
        "Url": "${MEILISEARCH_URL}",
        "ApiKey": "${MEILISEARCH_API_KEY}",
        "IndexPrefix": "${MEILISEARCH_INDEX_PREFIX:crm_}"
      }
    },
    "Notifications": {
      "Type": "${PROVIDER_NOTIFICATIONS_TYPE:BuiltIn}",
      "Novu": {
        "ApiKey": "${NOVU_API_KEY}",
        "ApplicationId": "${NOVU_APP_ID}"
      },
      "SendGrid": {
        "ApiKey": "${SENDGRID_API_KEY}",
        "FromEmail": "${SENDGRID_FROM_EMAIL}",
        "FromName": "${SENDGRID_FROM_NAME:CRM System}"
      }
    },
    "Analytics": {
      "Type": "${PROVIDER_ANALYTICS_TYPE:BuiltIn}",
      "Superset": {
        "Url": "${SUPERSET_URL}",
        "Username": "${SUPERSET_USERNAME}",
        "Password": "${SUPERSET_PASSWORD}",
        "GuestTokenEnabled": true
      }
    },
    "Signatures": {
      "Type": "${PROVIDER_SIGNATURES_TYPE:BuiltIn}",
      "DocuSeal": {
        "Url": "${DOCUSEAL_URL}",
        "ApiKey": "${DOCUSEAL_API_KEY}"
      }
    },
    "Integrations": {
      "Type": "${PROVIDER_INTEGRATIONS_TYPE:BuiltIn}",
      "N8n": {
        "Url": "${N8N_URL}",
        "ApiKey": "${N8N_API_KEY}"
      }
    },
    "Compliance": {
      "Type": "${PROVIDER_COMPLIANCE_TYPE:BuiltIn}",
      "Fides": {
        "Url": "${FIDES_URL}",
        "ApiKey": "${FIDES_API_KEY}"
      }
    },
    "AI": {
      "Type": "Ollama",
      "Groq": {
        "ApiKey": "",
        "Model": "mixtral-8x7b-32768",
        "TimeoutSeconds": 120,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7
      },
      "Ollama": {
        "BaseUrl": "http://crm-ollama:11434",
        "DefaultModel": "olmo2:7b",
        "EmbeddingModel": "nomic-embed-text",
        "TimeoutSeconds": 120,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7
      }
    }
  },
  "Redis": {
    "Configuration": "${REDIS_CONNECTION_STRING}",
    "InstanceName": "CRM_Prod:"
  },
  
  "AllowedHosts": "*"
}
