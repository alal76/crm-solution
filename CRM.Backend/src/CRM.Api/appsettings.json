{
  "DatabaseProvider": "mariadb",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  
  "FeatureManagement": {
    "UseExternalChat": false,
    "UseExternalSearch": false,
    "UseExternalNotifications": false,
    "UseExternalAnalytics": false,
    "UseExternalSignatures": false,
    "UseExternalAI": false,
    "UseExternalIntegrations": false,
    "EnableITSM": true,
    "EnableMarketing": true,
    "EnableCustomerPortal": false,
    "EnablePartnerPortal": false,
    "EnableKnowledgeBase": true,
    "NewSearchExperience": false,
    "AIAssistant": true,
    "RealTimeNotifications": true,
    "AdvancedWorkflows": true,
    "EnableAgentSubsystem": true,
    "EnableAgent_LeadScoring": true,
    "EnableAgent_SupportTriage": true,
    "EnableAgent_NextBestAction": true,
    "EnableAgent_SalesIntelligence": true,
    "EnableAgent_EmailAssistant": false,
    "EnableAgent_CustomerSuccess": false,
    "EnableAgent_RevenueIntelligence": false,
    "EnableAgent_TicketResolution": false,
    "EnableAgent_DocumentIntelligence": false,
    "EnableAgent_SalesCoach": false,
    "EnableAgent_MeetingIntelligence": false,
    "EnableAgent_ConversationIntelligence": false,
    "EnableAgentOrchestrator": true,
    "EnableAgentApprovalWorkflow": true,
    "EnableAgentMemory": true,
    "UseOptionalAuditLogging": false
  },

  "SemanticKernel": {
    "Enabled": true,
    "VectorStore": {
      "Provider": "Qdrant",
      "Qdrant": {
        "Host": "crm-qdrant",
        "Port": 6334,
        "ApiKey": "",
        "UseTls": false
      },
      "InMemory": {
        "Enabled": false
      },
      "EmbeddingDimension": 1536,
      "Collections": {
        "Accounts": "crm-accounts",
        "Contacts": "crm-contacts",
        "KBArticles": "crm-kb-articles",
        "Emails": "crm-emails",
        "Conversations": "crm-conversations",
        "AgentMemory": "crm-agent-memory"
      }
    },
    "Agents": {
      "MaxConcurrentConversations": 100,
      "DefaultTemperature": 0.3,
      "DefaultMaxTokens": 4096,
      "ApprovalTimeoutMinutes": 60,
      "ConversationHistoryLimit": 50,
      "MemorySearchTopK": 5,
      "MemoryMinSimilarity": 0.75,
      "CostBudgetPerDay": 50.00,
      "CostBudgetPerConversation": 0.50,
      "EnableStreaming": true,
      "BackgroundScoringIntervalHours": 6,
      "MemorySeedingBatchSize": 100
    },
    "Models": {
      "Default": "gpt-4o",
      "Scoring": "gpt-4o-mini",
      "Embedding": "text-embedding-3-small",
      "LargeContext": "gpt-4o"
    }
  },
  
  "Providers": {
    "Chat": {
      "Type": "BuiltIn",
      "Chatwoot": {
        "BaseUrl": "${CHATWOOT_BASE_URL:}",
        "ApiKey": "${CHATWOOT_API_KEY:}",
        "AccountId": "${CHATWOOT_ACCOUNT_ID:1}",
        "InboxId": "${CHATWOOT_INBOX_ID:1}"
      },
      "Intercom": {
        "AccessToken": "${INTERCOM_ACCESS_TOKEN:}",
        "AppId": "${INTERCOM_APP_ID:}",
        "BaseUrl": "${INTERCOM_BASE_URL:https://api.intercom.io}",
        "ApiVersion": "2.11",
        "WebhookSecret": "${INTERCOM_WEBHOOK_SECRET:}",
        "DefaultAdminId": "${INTERCOM_DEFAULT_ADMIN_ID:}",
        "DefaultTeamId": "${INTERCOM_DEFAULT_TEAM_ID:}",
        "TimeoutSeconds": 30
      }
    },
    "Search": {
      "Type": "BuiltIn",
      "Meilisearch": {
        "Url": "${MEILISEARCH_URL:http://localhost:7700}",
        "ApiKey": "${MEILISEARCH_API_KEY:}",
        "IndexPrefix": "crm_"
      },
      "Algolia": {
        "ApplicationId": "${ALGOLIA_APP_ID:}",
        "ApiKey": "${ALGOLIA_API_KEY:}",
        "IndexPrefix": "crm_"
      }
    },
    "Notifications": {
      "Type": "BuiltIn",
      "Novu": {
        "Url": "${NOVU_URL:https://api.novu.co/v1}",
        "ApiKey": "${NOVU_API_KEY:}",
        "ApplicationId": "${NOVU_APP_ID:crm-solution}",
        "UseSelfHosted": false,
        "TimeoutSeconds": 30,
        "EmailWorkflowId": "crm-email-notification",
        "SmsWorkflowId": "crm-sms-notification",
        "PushWorkflowId": "crm-push-notification",
        "InAppWorkflowId": "crm-inapp-notification",
        "EnableDetailedLogging": false,
        "MaxRetryAttempts": 3
      },
      "Twilio": {
        "AccountSid": "${TWILIO_ACCOUNT_SID:}",
        "AuthToken": "${TWILIO_AUTH_TOKEN:}",
        "FromPhoneNumber": "${TWILIO_FROM_NUMBER:}",
        "MessagingServiceSid": "${TWILIO_MESSAGING_SERVICE_SID:}",
        "WhatsAppFromNumber": "${TWILIO_WHATSAPP_FROM:}",
        "StatusCallbackUrl": "${TWILIO_STATUS_CALLBACK_URL:}",
        "TestMode": false,
        "TimeoutSeconds": 30
      },
      "SendGrid": {
        "ApiKey": "${SENDGRID_API_KEY:}",
        "FromEmail": "${SENDGRID_FROM_EMAIL:}",
        "FromName": "${SENDGRID_FROM_NAME:CRM System}",
        "ReplyToEmail": "${SENDGRID_REPLY_TO_EMAIL:}",
        "ReplyToName": "${SENDGRID_REPLY_TO_NAME:}",
        "EnableClickTracking": true,
        "EnableOpenTracking": true,
        "EnableSubscriptionTracking": false,
        "SandboxMode": false,
        "IpPoolName": "${SENDGRID_IP_POOL:}",
        "TimeoutSeconds": 30
      }
    },
    "Analytics": {
      "Type": "BuiltIn",
      "Superset": {
        "BaseUrl": "${SUPERSET_URL:http://localhost:8088}",
        "Username": "${SUPERSET_USERNAME:admin}",
        "Password": "${SUPERSET_PASSWORD:}",
        "Provider": "db",
        "TimeoutSeconds": 30,
        "TokenRefreshIntervalMinutes": 50,
        "GuestToken": {
          "DefaultExpirationMinutes": 60,
          "EnableRls": true
        },
        "DashboardMappings": {},
        "ChartMappings": {},
        "DefaultRlsFilters": {}
      },
      "PowerBI": {
        "TenantId": "${AZURE_TENANT_ID:}",
        "ClientId": "${POWERBI_CLIENT_ID:}",
        "ClientSecret": "${POWERBI_CLIENT_SECRET:}",
        "WorkspaceId": "${POWERBI_WORKSPACE_ID:}",
        "AuthMethod": "ServicePrincipal",
        "MasterUser": {
          "Username": "${POWERBI_MASTER_USER:}",
          "Password": "${POWERBI_MASTER_PASSWORD:}"
        },
        "TimeoutSeconds": 30,
        "TokenCacheMinutes": 55,
        "EnableRls": true,
        "DefaultRlsRole": "CRMUser",
        "RlsIdentityClaimType": "UserId",
        "DashboardMappings": {},
        "ReportMappings": {},
        "EmbedConfig": {
          "ExpirationMinutes": 60,
          "AllowEdit": false,
          "AllowSaveAs": false
        }
      }
    },
    "Signatures": {
      "Type": "BuiltIn",
      "DocuSeal": {
        "Url": "${DOCUSEAL_URL:http://localhost:3001}",
        "ApiKey": "${DOCUSEAL_API_KEY:}",
        "WebhookSecret": "${DOCUSEAL_WEBHOOK_SECRET:}",
        "TimeoutSeconds": 30
      },
      "DocuSign": {
        "IntegrationKey": "${DOCUSIGN_INTEGRATION_KEY:}",
        "UserId": "${DOCUSIGN_USER_ID:}",
        "AccountId": "${DOCUSIGN_ACCOUNT_ID:}",
        "RsaPrivateKey": "${DOCUSIGN_RSA_PRIVATE_KEY:}",
        "Environment": "${DOCUSIGN_ENVIRONMENT:demo}",
        "WebhookSecret": "${DOCUSIGN_WEBHOOK_SECRET:}",
        "EnableEmbeddedSigning": true,
        "JwtExpirationHours": 1,
        "OAuthScopes": "signature impersonation",
        "DefaultExpirationDays": 30,
        "DefaultReminderDays": 3
      }
    },
    "Integrations": {
      "Type": "BuiltIn",
      "BuiltIn": {
        "WebhookTimeoutSeconds": 30,
        "MaxRetryAttempts": 3,
        "RetryDelaySeconds": 5,
        "MaxConcurrentDeliveries": 10,
        "SignatureSecret": "${INTEGRATION_WEBHOOK_SECRET:}"
      },
      "N8n": {
        "BaseUrl": "${N8N_URL:http://localhost:5678}",
        "ApiKey": "${N8N_API_KEY:}",
        "TimeoutSeconds": 30,
        "MaxRetryAttempts": 3,
        "EventWebhooks": {
          "account.created": "/webhook/account-created",
          "account.updated": "/webhook/account-updated",
          "contact.created": "/webhook/contact-created",
          "opportunity.created": "/webhook/opportunity-created",
          "opportunity.won": "/webhook/opportunity-won",
          "*": "/webhook/crm-events"
        }
      },
      "Zapier": {
        "WebhookBaseUrl": "${ZAPIER_WEBHOOK_BASE_URL:https://hooks.zapier.com/hooks/catch}",
        "TimeoutSeconds": 30,
        "MaxRetryAttempts": 3,
        "EventWebhooks": {
          "account.created": "${ZAPIER_WEBHOOK_ACCOUNT_CREATED:}",
          "contact.created": "${ZAPIER_WEBHOOK_CONTACT_CREATED:}",
          "opportunity.created": "${ZAPIER_WEBHOOK_OPPORTUNITY_CREATED:}",
          "opportunity.won": "${ZAPIER_WEBHOOK_OPPORTUNITY_WON:}",
          "*": "${ZAPIER_WEBHOOK_ALL_EVENTS:}"
        }
      }
    },
    "Compliance": {
      "Type": "BuiltIn",
      "Fides": {
        "Url": "${FIDES_URL:http://localhost:8080}",
        "ApiKey": "${FIDES_API_KEY:}"
      }
    },
    "AI": {
      "Type": "Ollama",
      "Ollama": {
        "BaseUrl": "http://localhost:11434",
        "DefaultModel": "llama3",
        "EmbeddingModel": "nomic-embed-text",
        "TimeoutSeconds": 120,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7
      },
      "AzureOpenAI": {
        "Endpoint": "${AZURE_OPENAI_ENDPOINT:}",
        "ApiKey": "${AZURE_OPENAI_API_KEY:}",
        "DeploymentName": "${AZURE_OPENAI_DEPLOYMENT:gpt-4}",
        "EmbeddingDeploymentName": "${AZURE_OPENAI_EMBEDDING_DEPLOYMENT:text-embedding-ada-002}",
        "ApiVersion": "2024-02-15-preview",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7,
        "UseAzureADAuth": false,
        "TenantId": "${AZURE_TENANT_ID:}",
        "ClientId": "${AZURE_AI_CLIENT_ID:}",
        "ClientSecret": "${AZURE_AI_CLIENT_SECRET:}"
      },
      "Bedrock": {
        "Region": "${AWS_REGION:us-east-1}",
        "AccessKeyId": "${AWS_ACCESS_KEY_ID:}",
        "SecretAccessKey": "${AWS_SECRET_ACCESS_KEY:}",
        "SessionToken": "${AWS_SESSION_TOKEN:}",
        "UseDefaultCredentials": true,
        "DefaultModelId": "${BEDROCK_MODEL_ID:anthropic.claude-3-sonnet-20240229-v1:0}",
        "EmbeddingModelId": "${BEDROCK_EMBEDDING_MODEL_ID:amazon.titan-embed-text-v1}",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7
      },
      "OpenRouter": {
        "ApiKey": "${OPENROUTER_API_KEY:}",
        "BaseUrl": "https://openrouter.ai/api/v1",
        "DefaultModel": "${OPENROUTER_MODEL:openai/gpt-4o-mini}",
        "EmbeddingModel": "${OPENROUTER_EMBEDDING_MODEL:openai/text-embedding-3-small}",
        "TimeoutSeconds": 120,
        "MaxRetries": 3,
        "DefaultMaxTokens": 4096,
        "DefaultTemperature": 0.7,
        "SiteUrl": "${OPENROUTER_SITE_URL:}",
        "SiteName": "${OPENROUTER_SITE_NAME:CRM Solution}",
        "FallbackModels": [
          "anthropic/claude-3-haiku",
          "google/gemini-flash-1.5",
          "meta-llama/llama-3-8b-instruct"
        ]
      }
    },
    "Payment": {
      "Type": "Stripe",
      "Stripe": {
        "WebhookSecret": "${STRIPE_WEBHOOK_SECRET:}",
        "SecretKey": "${STRIPE_SECRET_KEY:}",
        "PublishableKey": "${STRIPE_PUBLISHABLE_KEY:}",
        "WebhookToleranceSeconds": 300,
        "ApiVersion": "2024-06-20"
      }
    }
  },
  
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@crm.local",
    "FromName": "CRM System",
    "TimeoutSeconds": 30
  },
  
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "crm_",
    "Enabled": true,
    "DefaultExpirationMinutes": 30,
    "ShortExpirationMinutes": 5,
    "LongExpirationMinutes": 120
  },
  "Monitoring": {
    "DeploymentType": "docker",
    "BuildServer": "localhost",
    "BuildServerFQDN": "crm.local",
    "ApiEndpoints": "",
    "DatabaseServers": "",
    "FrontendUrls": "",
    "RedisEndpoints": "",
    "KubernetesNamespace": "crm-app",
    "EnableK8sMonitoring": false,
    "EnableDockerMonitoring": true,
    "HealthCheckTimeoutSeconds": 5,
    "CacheDurationSeconds": 30,
    "DatabaseProvider": "mariadb",
    "MssqlVersion": "2022-latest",
    "MssqlEdition": "Express",
    "MssqlToolsPath": "/opt/mssql-tools18/bin",
    "MssqlHealthInterval": "30s",
    "MssqlHealthTimeout": "10s",
    "MssqlHealthRetries": "5",
    "MssqlStartPeriod": "60s",
    "MssqlCollation": "SQL_Latin1_General_CP1_CI_AS"
  },
  "Frontend": {
    "Url": "http://localhost"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET:DEVELOPMENT_ONLY_CHANGE_IN_PRODUCTION_32CHARS!}",
    "Issuer": "${JWT_ISSUER:CRMApp}",
    "Audience": "${JWT_AUDIENCE:CRMUsers}",
    "ExpirationMinutes": 60
  },
  "OAuth": {
    "Google": {
      "ClientId": "${GOOGLE_CLIENT_ID:}",
      "ClientSecret": "${GOOGLE_CLIENT_SECRET:}"
    },
    "GitHub": {
      "ClientId": "${GITHUB_CLIENT_ID:}",
      "ClientSecret": "${GITHUB_CLIENT_SECRET:}"
    },
    "Microsoft": {
      "ClientId": "${MICROSOFT_CLIENT_ID:}",
      "ClientSecret": "${MICROSOFT_CLIENT_SECRET:}"
    },
    "LinkedIn": {
      "ClientId": "${LINKEDIN_CLIENT_ID:}",
      "ClientSecret": "${LINKEDIN_CLIENT_SECRET:}",
      "Scopes": "r_liteprofile r_emailaddress",
      "TimeoutSeconds": 30
    },
    "Apple": {
      "ClientId": "${APPLE_CLIENT_ID:}",
      "TeamId": "${APPLE_TEAM_ID:}",
      "KeyId": "${APPLE_KEY_ID:}",
      "PrivateKey": "${APPLE_PRIVATE_KEY:}",
      "TimeoutSeconds": 30
    }
  },
  "OTP": {
    "SMS": {
      "TwilioAccountSid": "${TWILIO_ACCOUNT_SID:}",
      "TwilioAuthToken": "${TWILIO_AUTH_TOKEN:}",
      "FromPhoneNumber": "${TWILIO_PHONE_NUMBER:+1234567890}",
      "OtpExpirationSeconds": 300,
      "OtpLength": 6,
      "MaxAttempts": 5,
      "MaxOtpsPerHour": 3,
      "StorageType": "Memory"
    },
    "Email": {
      "SendGridApiKey": "${SENDGRID_API_KEY:}",
      "FromAddress": "${SENDGRID_FROM_EMAIL:noreply@crm.local}",
      "FromName": "${SENDGRID_FROM_NAME:CRM System}",
      "OtpExpirationSeconds": 900,
      "OtpLength": 8,
      "MaxAttempts": 5,
      "MaxEmailsPerHour": 5,
      "StorageType": "Memory",
      "TemplateName": "OTPVerification"
    }
  },
  "ZipCodeImport": {
    "EnableScheduledImport": false,
    "CronExpression": "0 0 1 * *",
    "ImportSource": "GeoNames",
    "CountryCodes": ["US"],
    "ImportOnStartupIfEmpty": true,
    "MinimumHoursBetweenImports": 168
  },
  "NewsSocial": {
    "CacheMinutes": 15,
    "EnableSentimentAnalysis": true,
    "NewsApi": {
      "ApiKey": "${NEWSAPI_API_KEY:}",
      "BaseUrl": "https://newsapi.org/v2",
      "Enabled": true
    },
    "Twitter": {
      "BearerToken": "${TWITTER_BEARER_TOKEN:}",
      "ApiKey": "${TWITTER_API_KEY:}",
      "ApiSecret": "${TWITTER_API_SECRET:}",
      "BaseUrl": "https://api.twitter.com/2",
      "Enabled": true
    },
    "LinkedIn": {
      "AccessToken": "${LINKEDIN_ACCESS_TOKEN:}",
      "ClientId": "${LINKEDIN_CLIENT_ID:}",
      "ClientSecret": "${LINKEDIN_CLIENT_SECRET:}",
      "BaseUrl": "https://api.linkedin.com/v2",
      "Enabled": true
    }
  },
  "Workflow": {
    "MaxConcurrentTasks": 5,
    "PollIntervalSeconds": 5,
    "LockDurationMinutes": 15,
    "EnableLLMActions": true
  },
  "LLMProviders": {
    "DefaultProvider": "local",
    "EnableFallback": true,
    "FallbackOrder": ["local", "allenai", "openai", "azure", "anthropic", "google", "deepseek", "groq"],
    "TimeoutSeconds": 60,
    "MaxRetries": 3,
    "DefaultMaxTokens": 1000,
    "DefaultTemperature": 0.7,

    "OpenAI": {
      "ApiKey": "${OPENAI_API_KEY:}",
      "BaseUrl": "https://api.openai.com/v1",
      "DefaultModel": "gpt-4",
      "Organization": ""
    },

    "AzureOpenAI": {
      "Endpoint": "${AZURE_OPENAI_ENDPOINT:}",
      "ApiKey": "${AZURE_OPENAI_API_KEY:}",
      "DeploymentName": "${AZURE_OPENAI_DEPLOYMENT:}",
      "ApiVersion": "2024-02-01",
      "DefaultModel": "gpt-4"
    },

    "Anthropic": {
      "ApiKey": "${ANTHROPIC_API_KEY:}",
      "BaseUrl": "https://api.anthropic.com/v1",
      "DefaultModel": "claude-3-sonnet-20240229",
      "ApiVersion": "2023-06-01"
    },

    "GoogleCloud": {
      "ProjectId": "${GOOGLE_CLOUD_PROJECT_ID:}",
      "Location": "us-central1",
      "ApiKey": "${GOOGLE_AI_API_KEY:}",
      "ServiceAccountKeyPath": "${GOOGLE_APPLICATION_CREDENTIALS:}",
      "DefaultModel": "gemini-1.5-pro",
      "UseVertexAI": false
    },

    "AWSBedrock": {
      "Region": "${AWS_REGION:us-east-1}",
      "AccessKeyId": "${AWS_ACCESS_KEY_ID:}",
      "SecretAccessKey": "${AWS_SECRET_ACCESS_KEY:}",
      "SessionToken": "${AWS_SESSION_TOKEN:}",
      "DefaultModel": "anthropic.claude-3-sonnet-20240229-v1:0",
      "UseDefaultCredentials": true
    },

    "DeepSeek": {
      "ApiKey": "${DEEPSEEK_API_KEY:}",
      "BaseUrl": "https://api.deepseek.com",
      "DefaultModel": "deepseek-chat"
    },

    "Groq": {
      "ApiKey": "${GROQ_API_KEY:}",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "DefaultModel": "llama-3.3-70b-versatile"
    },

    "AllenAI": {
      "ApiKey": "${HUGGINGFACE_API_KEY:}",
      "HuggingFaceApiKey": "${HUGGINGFACE_API_KEY:}",
      "BaseUrl": "https://api-inference.huggingface.co/models",
      "OLMoEndpoint": "https://api-inference.huggingface.co/models/allenai/OLMo-7B",
      "TuluEndpoint": "https://api-inference.huggingface.co/models/allenai/tulu-2-7b",
      "DefaultModel": "allenai/OLMo-7B-Instruct",
      "Enabled": true,
      "MaxNewTokens": 1000,
      "Temperature": 0.7,
      "TimeoutSeconds": 60,
      "MaxRetries": 3,
      "EnableCaching": true,
      "CacheExpirationMinutes": 60,
      "EnableLocalFallback": true,
      "BatchSize": 10
    },

    "LocalLLM": {
      "BaseUrl": "${LOCAL_LLM_URL:http://localhost:11434}",
      "ApiKey": "",
      "DefaultModel": "olmo2:7b",
      "ApiFormat": "ollama",
      "Enabled": true,
      "FallbackModel": "qwen2.5:0.5b",
      "Headers": {}
    },

    "CustomEndpoint": {
      "Url": "${CUSTOM_LLM_URL:}",
      "ApiKey": "${CUSTOM_LLM_API_KEY:}",
      "Headers": {}
    }
  },
  "Resilience": {
    "DefaultTimeoutSeconds": 30,
    "CircuitBreakerThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMs": 500,
    "RetryMaxDelayMs": 30000,
    "EnableCircuitBreaker": true,
    "EnableRetry": true,
    "Services": {
      "llm-openai": {
        "TimeoutSeconds": 60,
        "CircuitBreakerThreshold": 3
      },
      "llm-azure": {
        "TimeoutSeconds": 60,
        "CircuitBreakerThreshold": 3
      },
      "llm-anthropic": {
        "TimeoutSeconds": 60,
        "CircuitBreakerThreshold": 3
      },
      "llm-google": {
        "TimeoutSeconds": 60,
        "CircuitBreakerThreshold": 3
      },
      "llm-bedrock": {
        "TimeoutSeconds": 90,
        "CircuitBreakerThreshold": 3
      },
      "llm-deepseek": {
        "TimeoutSeconds": 60,
        "CircuitBreakerThreshold": 3
      },
      "llm-local": {
        "TimeoutSeconds": 120,
        "CircuitBreakerThreshold": 5
      },
      "webhook": {
        "TimeoutSeconds": 15,
        "CircuitBreakerThreshold": 5
      }
    }
  },
  "AllowedOrigins": "${ALLOWED_ORIGINS:http://localhost:3000,https://localhost:3000}",
  "RateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededMessage": "API calls quota exceeded!",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 1000
      }
    ],
    "EndpointRules": {
      "/api/auth/login": { "Period": "1m", "Limit": 5 },
      "/api/auth/register": { "Period": "1h", "Limit": 3 },
      "/api/auth/verify-2fa": { "Period": "1m", "Limit": 10 },
      "/api/auth/forgot-password": { "Period": "1h", "Limit": 5 },
      "/api/auth/refresh-token": { "Period": "1m", "Limit": 10 },
      "/api/auth/logout": { "Period": "1m", "Limit": 30 },
      "/api/customers": { "Period": "1m", "Limit": 500 },
      "/api/contacts": { "Period": "1m", "Limit": 500 },
      "/api/opportunities": { "Period": "1m", "Limit": 500 },
      "/api/products": { "Period": "1m", "Limit": 500 },
      "/api/activities": { "Period": "1m", "Limit": 300 },
      "/api/workflowengine": { "Period": "1m", "Limit": 200 },
      "/api/reports": { "Period": "1m", "Limit": 100 },
      "/api/dashboard": { "Period": "1m", "Limit": 200 },
      "/api/llm": { "Period": "1m", "Limit": 60 }
    }
  },

  "Authentication": {
    "Jwt": {
      "Secret": "your-jwt-secret-key-minimum-32-characters-required",
      "Issuer": "CRM.Api",
      "Audience": "CRM.Client",
      "ExpirationMinutes": 60,
      "RefreshTokenExpiryDays": 7
    }
  },

  "Phase1": {
    "LinkedIn": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://localhost:5001/auth/callback/linkedin"
    },
    "Apple": {
      "TeamId": "",
      "ClientId": "",
      "KeyId": "",
      "PrivateKey": "",
      "RedirectUri": "https://localhost:5001/auth/callback/apple"
    },
    "SmsOtp": {
      "Provider": "Twilio",
      "ExpirationSeconds": 300,
      "MaxAttempts": 5
    },
    "EmailOtp": {
      "ExpirationSeconds": 600,
      "MaxAttempts": 5,
      "SenderEmail": "noreply@crm.example.com"
    }
  },

  "Phase2": {
    "Totp": {
