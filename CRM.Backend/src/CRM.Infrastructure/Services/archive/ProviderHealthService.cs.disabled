using CRM.Core.Dtos;
using CRM.Core.Interfaces;
using CRM.Core.Ports.Output.Providers;
using CRM.Infrastructure.Factories;
using Microsoft.Extensions.Logging;

namespace CRM.Infrastructure.Services;

/// <summary>
/// Service for monitoring and reporting health status of all pluggable providers.
/// Provides real-time health checks and performance metrics for each provider.
///
/// HEXAGONAL ARCHITECTURE:
/// - Implements IProviderHealthService (port)
/// - Uses provider factories and health check capabilities
/// - Caches health status to avoid repeated checks
/// </summary>
public class ProviderHealthService : IProviderHealthService
{
    private readonly ILogger<ProviderHealthService> _logger;
    private readonly AdapterRegistry _registry;
    private int _healthCheckIntervalSeconds = 300; // 5 minutes
    private DateTime _lastHealthCheckTime = DateTime.MinValue;

    // In-memory cache for health status
    private Dictionary<string, ProviderHealthDto> _healthCache = new();
    private object _cacheLock = new();

    public ProviderHealthService(
        ILogger<ProviderHealthService> logger,
        AdapterRegistry registry)
    {
        _logger = logger;
        _registry = registry;
    }

    #region Individual Provider Health

    public async Task<ProviderHealthDto> GetProviderHealthAsync(string providerCategory, string providerName, CancellationToken cancellationToken = default)
    {
        try
        {
            var cacheKey = $"{providerCategory}:{providerName}";

            // Check cache first
            lock (_cacheLock)
            {
                if (_healthCache.TryGetValue(cacheKey, out var cached))
                {
                    // Return if still fresh (within health check interval)
                    if (DateTime.UtcNow.Subtract(cached.LastCheckedAt ?? DateTime.MinValue).TotalSeconds < _healthCheckIntervalSeconds)
                    {
                        return cached;
                    }
                }
            }

            // Perform check
            var detail = await PerformProviderHealthCheckAsync(providerCategory, providerName, cancellationToken);
            
            // Cache result
            var dto = new ProviderHealthDto
            {
                Category = providerCategory,
                ProviderName = providerName,
                DisplayName = GetProviderDisplayName(providerName),
                Status = (int)detail.Status,
                StatusText = ((ProviderHealthStatus)detail.Status).ToString(),
                LastCheckedAt = detail.CheckedAt,
                ResponseTimeMs = detail.ResponseTimeMs,
                ErrorMessage = detail.Errors.FirstOrDefault(),
                IsConfigured = detail.Status != ProviderHealthStatus.NotConfigured
            };

            lock (_cacheLock)
            {
                _healthCache[cacheKey] = dto;
            }

            return dto;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error getting health for provider {providerCategory}:{providerName}");
            return new ProviderHealthDto
            {
                Category = providerCategory,
                ProviderName = providerName,
                DisplayName = GetProviderDisplayName(providerName),
                Status = (int)ProviderHealthStatus.Unknown,
                StatusText = ProviderHealthStatus.Unknown.ToString(),
                ErrorMessage = ex.Message
            };
        }
    }

    public async Task<IEnumerable<ProviderHealthDto>> GetCategoryProvidersHealthAsync(string category, CancellationToken cancellationToken = default)
    {
        try
        {
            var providerNames = GetProviderNamesForCategory(category);
            var tasks = providerNames.Select(name => GetProviderHealthAsync(category, name, cancellationToken));
            var results = await Task.WhenAll(tasks);
            return results.ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error getting health for category {category}");
            return Enumerable.Empty<ProviderHealthDto>();
        }
    }

    #endregion

    #region All Providers Health

    public async Task<IDictionary<string, IEnumerable<ProviderHealthDto>>> GetAllProvidersHealthAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var categories = new[] { "Search", "Chat", "Notifications", "Analytics", "Signatures", "AI", "Integrations" };
            var result = new Dictionary<string, IEnumerable<ProviderHealthDto>>();

            foreach (var category in categories)
            {
                var categoryHealth = await GetCategoryProvidersHealthAsync(category, cancellationToken);
                result[category] = categoryHealth.ToList();
            }

            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting all providers health");
            return new Dictionary<string, IEnumerable<ProviderHealthDto>>();
        }
    }

    public async Task<ProviderHealthDashboardDto> GetProviderHealthDashboardAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var allHealth = await GetAllProvidersHealthAsync(cancellationToken);

            var dashboard = new ProviderHealthDashboardDto
            {
                LastRefreshAt = DateTime.UtcNow,
                ProvidersByCategory = allHealth.ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value.ToList()
                )
            };

            // Calculate aggregates
            var allProviders = allHealth.Values.SelectMany(v => v).ToList();
            dashboard.TotalProviders = allProviders.Count;
            dashboard.HealthyCount = allProviders.Count(p => p.Status == (int)ProviderHealthStatus.Healthy);
            dashboard.DegradedCount = allProviders.Count(p => p.Status == (int)ProviderHealthStatus.Degraded);
            dashboard.UnhealthyCount = allProviders.Count(p => p.Status == (int)ProviderHealthStatus.Unhealthy);
            dashboard.NotConfiguredCount = allProviders.Count(p => p.Status == (int)ProviderHealthStatus.NotConfigured);

            return dashboard;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting provider health dashboard");
            return new ProviderHealthDashboardDto { LastRefreshAt = DateTime.UtcNow };
        }
    }

    #endregion

    #region Health Checks

    public async Task<ProviderHealthCheckDetailDto> PerformProviderHealthCheckAsync(string providerCategory, string providerName, CancellationToken cancellationToken = default)
    {
        try
        {
            var startTime = DateTime.UtcNow;
            var diagnostics = new Dictionary<string, object>();
            var errors = new List<string>();
            var warnings = new List<string>();

            ProviderHealthStatus status;

            try
            {
                // Simulate health check - in real implementation, would check actual provider
                // This is where provider-specific health checks would be implemented
                status = ProviderHealthStatus.Healthy;
                diagnostics["CheckedAt"] = startTime;
                diagnostics["Provider"] = providerName;
            }
            catch (Exception ex)
            {
                status = ProviderHealthStatus.Unhealthy;
                errors.Add(ex.Message);
            }

            var elapsed = (int)DateTime.UtcNow.Subtract(startTime).TotalMilliseconds;

            return new ProviderHealthCheckDetailDto
            {
                Category = providerCategory,
                ProviderName = providerName,
                Status = (int)status,
                StatusMessage = status.ToString(),
                CheckedAt = startTime,
                ResponseTimeMs = elapsed,
                Diagnostics = diagnostics,
                Warnings = warnings,
                Errors = errors
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error performing health check for {providerCategory}:{providerName}");
            return new ProviderHealthCheckDetailDto
            {
                Category = providerCategory,
                ProviderName = providerName,
                Status = (int)ProviderHealthStatus.Unknown,
                StatusMessage = "Check failed",
                CheckedAt = DateTime.UtcNow,
                ResponseTimeMs = 0,
                Errors = new List<string> { ex.Message }
            };
        }
    }

    public async Task<IDictionary<string, IEnumerable<ProviderHealthCheckDetailDto>>> PerformAllHealthChecksAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var categories = new[] { "Search", "Chat", "Notifications", "Analytics", "Signatures", "AI", "Integrations" };
            var result = new Dictionary<string, IEnumerable<ProviderHealthCheckDetailDto>>();

            foreach (var category in categories)
            {
                var providerNames = GetProviderNamesForCategory(category);
                var tasks = providerNames.Select(name => PerformProviderHealthCheckAsync(category, name, cancellationToken));
                var checks = await Task.WhenAll(tasks);
                result[category] = checks.ToList();
            }

            _lastHealthCheckTime = DateTime.UtcNow;
            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error performing all health checks");
            return new Dictionary<string, IEnumerable<ProviderHealthCheckDetailDto>>();
        }
    }

    #endregion

    #region Performance Metrics

    public async Task<ProviderPerformanceMetricsDto> GetProviderPerformanceMetricsAsync(string providerCategory, string providerName, int hoursBack = 24, CancellationToken cancellationToken = default)
    {
        try
        {
            // In real implementation, would retrieve from metrics database/monitoring system
            return new ProviderPerformanceMetricsDto
            {
                ProviderName = providerName,
                AverageResponseTimeMs = 150,
                MaxResponseTimeMs = 500,
                MinResponseTimeMs = 50,
                ErrorRatePercent = 0.1m,
                TotalRequests = 10000,
                FailedRequests = 10,
                ThroughputRequestsPerSecond = 2.5m,
                MeasurementStart = DateTime.UtcNow.AddHours(-hoursBack),
                MeasurementEnd = DateTime.UtcNow
            };
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error getting performance metrics for {providerCategory}:{providerName}");
            throw;
        }
    }

    public async Task<IDictionary<string, ProviderPerformanceMetricsDto>> GetAllPerformanceMetricsAsync(int hoursBack = 24, CancellationToken cancellationToken = default)
    {
        try
        {
            var result = new Dictionary<string, ProviderPerformanceMetricsDto>();
            var categories = new[] { "Search", "Chat", "Notifications", "Analytics", "Signatures", "AI", "Integrations" };

            foreach (var category in categories)
            {
                var providerNames = GetProviderNamesForCategory(category);
                foreach (var providerName in providerNames)
                {
                    var metrics = await GetProviderPerformanceMetricsAsync(category, providerName, hoursBack, cancellationToken);
                    result[$"{category}:{providerName}"] = metrics;
                }
            }

            return result;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting all performance metrics");
            return new Dictionary<string, ProviderPerformanceMetricsDto>();
        }
    }

    #endregion

    #region Fallback & Redundancy

    public async Task<IEnumerable<string>> GetFallbackProvidersAsync(string category, CancellationToken cancellationToken = default)
    {
        try
        {
            // Fallback provider chain (would be configurable in real implementation)
            var fallbacks = new Dictionary<string, List<string>>
            {
                { "Search", new List<string> { "Elasticsearch", "Algolia" } },
                { "Chat", new List<string> { "Intercom", "Zendesk" } },
                { "Notifications", new List<string> { "SendGrid", "Twilio" } },
                { "Analytics", new List<string> { "Looker", "PowerBI" } },
                { "Signatures", new List<string> { "DocuSign", "HelloSign" } },
                { "AI", new List<string> { "OpenAI", "Anthropic" } }
            };

            return fallbacks.ContainsKey(category) ? fallbacks[category] : Enumerable.Empty<string>();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error getting fallback providers for {category}");
            return Enumerable.Empty<string>();
        }
    }

    public async Task<string?> GetAvailableFallbackProviderAsync(string category, CancellationToken cancellationToken = default)
    {
        try
        {
            var fallbacks = await GetFallbackProvidersAsync(category, cancellationToken);
            
            foreach (var fallback in fallbacks)
            {
                var health = await GetProviderHealthAsync(category, fallback, cancellationToken);
                if (health.Status == (int)ProviderHealthStatus.Healthy)
                {
                    return fallback;
                }
            }

            return null;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, $"Error getting available fallback for {category}");
            return null;
        }
    }

    #endregion

    #region Alerts & Notifications

    public async Task<IEnumerable<ProviderHealthAlertDto>> GetProviderHealthAlertsAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var alerts = new List<ProviderHealthAlertDto>();
            var allHealth = await GetAllProvidersHealthAsync(cancellationToken);

            foreach (var category in allHealth.Keys)
            {
                foreach (var provider in allHealth[category])
                {
                    if (provider.Status == (int)ProviderHealthStatus.Unhealthy)
                    {
                        alerts.Add(new ProviderHealthAlertDto
                        {
                            Id = provider.ProviderName.GetHashCode(),
                            ProviderName = provider.ProviderName,
                            Category = category,
                            AlertType = "Critical",
                            Message = $"Provider {provider.ProviderName} is unhealthy: {provider.ErrorMessage}",
                            AlertedAt = DateTime.UtcNow,
                            IsResolved = false
                        });
                    }
                    else if (provider.Status == (int)ProviderHealthStatus.Degraded)
                    {
                        alerts.Add(new ProviderHealthAlertDto
                        {
                            Id = provider.ProviderName.GetHashCode(),
                            ProviderName = provider.ProviderName,
                            Category = category,
                            AlertType = "Warning",
                            Message = $"Provider {provider.ProviderName} is degraded",
                            AlertedAt = DateTime.UtcNow,
                            IsResolved = false
                        });
                    }
                }
            }

            return alerts;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting provider health alerts");
            return Enumerable.Empty<ProviderHealthAlertDto>();
        }
    }

    public async Task<bool> HasCriticalProvidersAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var alerts = await GetProviderHealthAlertsAsync(cancellationToken);
            return alerts.Any(a => a.AlertType == "Critical");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error checking for critical providers");
            return false;
        }
    }

    public async Task<IEnumerable<string>> GetProvidersWithIssuesAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            var alerts = await GetProviderHealthAlertsAsync(cancellationToken);
            return alerts.Select(a => a.ProviderName).Distinct().ToList();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error getting providers with issues");
            return Enumerable.Empty<string>();
        }
    }

    #endregion

    #region Configuration & Cache

    public async Task RefreshProviderHealthCacheAsync(CancellationToken cancellationToken = default)
    {
        try
        {
            lock (_cacheLock)
            {
                _healthCache.Clear();
            }
            _lastHealthCheckTime = DateTime.MinValue;
            _logger.LogInformation("Provider health cache refreshed");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error refreshing provider health cache");
        }
    }

    public void SetHealthCheckIntervalSeconds(int intervalSeconds)
    {
        _healthCheckIntervalSeconds = intervalSeconds;
        _logger.LogInformation($"Health check interval set to {intervalSeconds} seconds");
    }

    #endregion

    #region Private Helpers

    private List<string> GetProviderNamesForCategory(string category)
    {
        return category switch
        {
            "Search" => new List<string> { "Meilisearch", "Algolia", "Elasticsearch" },
            "Chat" => new List<string> { "Chatwoot", "Intercom" },
            "Notifications" => new List<string> { "Novu", "Twilio", "SendGrid" },
            "Analytics" => new List<string> { "Superset", "Metabase", "PowerBI" },
            "Signatures" => new List<string> { "DocuSeal", "DocuSign" },
            "AI" => new List<string> { "Ollama", "OpenAI", "Azure", "Anthropic" },
            "Integrations" => new List<string> { "N8n", "Zapier" },
            _ => new List<string>()
        };
    }

    private string GetProviderDisplayName(string providerName)
    {
        return providerName switch
        {
            "Meilisearch" => "Meilisearch Search",
            "Algolia" => "Algolia Search",
            "Chatwoot" => "Chatwoot Chat",
            "Novu" => "Novu Notifications",
            "DocuSeal" => "DocuSeal Signatures",
            "Ollama" => "Ollama AI",
            "OpenAI" => "OpenAI GPT",
            _ => providerName
        };
    }

    #endregion
}
