using CRM.Core.Dtos;
using CRM.Core.Entities;
using CRM.Core.Interfaces;
using CRM.Infrastructure.Data;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;

namespace CRM.Infrastructure.Services;

/// <summary>
/// Dunning Manager Interface - Payment failure recovery with intelligent retry escalation.
/// </summary>
public interface IDunningManager
{
    /// <summary>
    /// Process all dunning records (background job, runs twice daily).
    /// Finds records with NextRetryDate <= Today and attempts payment retry.
    /// </summary>
    Task ProcessDunningAsync(CancellationToken cancellationToken);

    /// <summary>
    /// Handle payment failure - create dunning record and schedule first retry.
    /// </summary>
    Task<DunningRecordDto> HandlePaymentFailureAsync(
        int invoiceId,
        int subscriptionId,
        string reason,
        CancellationToken cancellationToken);

    /// <summary>
    /// Get dunning history for a subscription.
    /// </summary>
    Task<List<DunningRecordDto>> GetDunningHistoryAsync(int subscriptionId, CancellationToken cancellationToken);

    /// <summary>
    /// Manually retry a dunning record (admin override).
    /// </summary>
    Task<DunningRecordDto> ManualRetryAsync(int dunningRecordId, CancellationToken cancellationToken);
}

/// <summary>
/// Implementation of IDunningManager.
/// 
/// RECOVERY STRATEGY:
/// Attempt 1: +3 days after failure → Send retry payment email
/// Attempt 2: +6 days after Attempt 1 → Send escalation email + notify account manager
/// Attempt 3: +9 days after Attempt 2 → Send final warning email
/// After 3 failures: Mark Exhausted → Auto-cancel subscription or manual collection
/// 
/// GRACE PERIOD:
/// After Attempt 3 failure, enter GracePeriod (3 additional days without charging).
/// During grace period, send escalation notifications and escalate to account manager.
/// After grace period, subscription auto-cancels if not manually resolved.
/// 
/// AUDIT TRAIL:
/// All attempts logged with error messages, retry dates, and notification details.
/// Customers can see dunning status in customer portal.
/// </summary>
public class DunningManager : IDunningManager
{
    private readonly ICrmDbContext _context;
    private readonly IPaymentService _paymentService;
    private readonly ILogger<DunningManager> _logger;

    private const int MaxRetryAttempts = 3;
    private const int GracePeriodDays = 3;

    // Retry schedule (days after previous attempt or initial failure)
    private static readonly int[] RetryScheduleDays = { 3, 7, 14 }; // Day 3, Day 10, Day 24 from initial failure

    public DunningManager(
        ICrmDbContext context,
        IPaymentService paymentService,
        ILogger<DunningManager> logger)
    {
        _context = context ?? throw new ArgumentNullException(nameof(context));
        _paymentService = paymentService ?? throw new ArgumentNullException(nameof(paymentService));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }

    /// <summary>
    /// Process all active dunning records (background job, twice daily).
    /// Finds records with NextRetryDate <= Today and attempts payment retry.
    /// </summary>
    public async Task ProcessDunningAsync(CancellationToken cancellationToken)
    {
        try
        {
            _logger.LogInformation("Starting dunning process");

            var utcNow = DateTime.UtcNow;
            var dunningsDue = await _context.Set<DunningRecord>()
                .Include(d => d.Subscription)
                .Include(d => d.Invoice)
                .Where(d => d.Status == DunningStatus.Active &&
                           d.NextRetryDate <= utcNow &&
                           !d.Subscription!.IsDeleted)
                .OrderBy(d => d.NextRetryDate)
                .ToListAsync(cancellationToken);

            _logger.LogInformation("Found {Count} dunning records due for retry", dunningsDue.Count);

            var successCount = 0;
            var failureCount = 0;

            foreach (var record in dunningsDue)
            {
                try
                {
                    if (await ProcessDunningRetryAsync(record, cancellationToken))
                        successCount++;
                    else
                        failureCount++;
                }
                catch (Exception ex)
                {
                    failureCount++;
                    _logger.LogError(ex, "Error processing dunning record {RecordId}", record.Id);
                }
            }

            _logger.LogInformation(
                "Dunning process complete: {Success} succeeded, {Failed} failed",
                successCount, failureCount);
        }
        catch (Exception ex)
        {
            _logger.LogCritical(ex, "Critical error in dunning process");
            throw;
        }
    }

    /// <summary>
    /// Handle payment failure - create initial dunning record.
    /// </summary>
    public async Task<DunningRecordDto> HandlePaymentFailureAsync(
        int invoiceId,
        int subscriptionId,
        string reason,
        CancellationToken cancellationToken)
    {
        var invoice = await _context.Invoices
            .FirstOrDefaultAsync(i => i.Id == invoiceId, cancellationToken);

        if (invoice == null)
            throw new InvalidOperationException($"Invoice {invoiceId} not found");

        var subscription = await _context.Subscriptions
            .FirstOrDefaultAsync(s => s.Id == subscriptionId && !s.IsDeleted, cancellationToken);

        if (subscription == null)
            throw new InvalidOperationException($"Subscription {subscriptionId} not found");

        var dunningRecord = new DunningRecord
        {
            SubscriptionId = subscriptionId,
            InvoiceId = invoiceId,
            RetryAttempt = 1,
            NextRetryDate = DateTime.UtcNow.AddDays(RetryScheduleDays[0]), // Day 3
            Status = DunningStatus.Active,
            Reason = reason,
            InitialFailureDate = DateTime.UtcNow,
            NotificationEmail = subscription.BillingContactEmail,
            OutstandingAmount = invoice.Amount,
            Notes = $"Initial failure: {reason}"
        };

        _context.Set<DunningRecord>().Add(dunningRecord);
        await _context.SaveChangesAsync(cancellationToken);

        _logger.LogWarning(
            "Created dunning record: Invoice={InvoiceId}, Subscription={SubId}, NextRetry={Date}",
            invoiceId, subscriptionId, dunningRecord.NextRetryDate);

        return MapToDto(dunningRecord);
    }

    /// <summary>
    /// Process a single dunning retry attempt.
    /// </summary>
    private async Task<bool> ProcessDunningRetryAsync(DunningRecord record, CancellationToken cancellationToken)
    {
        try
        {
            // Attempt payment retry
            var paymentSuccess = await _paymentService.ProcessAsync(
                record.InvoiceId,
                record.OutstandingAmount,
                cancellationToken);

            if (paymentSuccess)
            {
                // Payment succeeded - resolve dunning
                record.Status = DunningStatus.Resolved;
                record.RecoveredAmount = record.OutstandingAmount;
                record.Notes = $"Payment succeeded on retry attempt {record.RetryAttempt}";

                _logger.LogInformation(
                    "Dunning resolved: Invoice={InvoiceId}, Attempt={Attempt}",
                    record.InvoiceId, record.RetryAttempt);

                _context.Set<DunningRecord>().Update(record);
                await _context.SaveChangesAsync(cancellationToken);
                return true;
            }

            // Payment failed - schedule next retry or exhaust
            if (record.RetryAttempt < MaxRetryAttempts)
            {
                record.RetryAttempt++;
                record.NextRetryDate = DateTime.UtcNow.AddDays(RetryScheduleDays[record.RetryAttempt - 1]);
                record.Notes += $"\nAttempt {record.RetryAttempt} scheduled for {record.NextRetryDate:yyyy-MM-dd}";

                _logger.LogWarning(
                    "Payment retry failed: Invoice={InvoiceId}, Attempt={Current}/{Max}, NextRetry={Date}",
                    record.InvoiceId, record.RetryAttempt, MaxRetryAttempts, record.NextRetryDate);
            }
            else
            {
                // All retries exhausted
                record.Status = DunningStatus.Exhausted;
                record.IsExhausted = true;
                record.GracePeriodEndDate = DateTime.UtcNow.AddDays(GracePeriodDays);
                record.Notes += $"\nDunning exhausted after {MaxRetryAttempts} attempts. Grace period until {record.GracePeriodEndDate:yyyy-MM-dd}";

                // Auto-cancel subscription if configured
                var subscription = await _context.Subscriptions
                    .FirstOrDefaultAsync(s => s.Id == record.SubscriptionId, CancellationToken.None);

                if (subscription != null)
                {
                    subscription.SubscriptionStatus = SubscriptionStatus.Cancelled;
                    subscription.CancelledAt = DateTime.UtcNow;
                    subscription.CancellationReason = "Dunning exhausted - payment collection failed after " + MaxRetryAttempts + " attempts";
                    subscription.UpdatedAt = DateTime.UtcNow;

                    _context.Subscriptions.Update(subscription);
                }

                _logger.LogError(
                    "Dunning exhausted: Invoice={InvoiceId}, Subscription={SubId}, Auto-cancelled",
                    record.InvoiceId, record.SubscriptionId);
            }

            _context.Set<DunningRecord>().Update(record);
            await _context.SaveChangesAsync(cancellationToken);
            return false;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error processing dunning retry: DunningId={Id}", record.Id);
            
            // Log error but mark as non-retriable failures
            record.LastErrorMessage = ex.Message;
            _context.Set<DunningRecord>().Update(record);
            await _context.SaveChangesAsync(cancellationToken);
            return false;
        }
    }

    /// <summary>
    /// Get dunning history for a subscription.
    /// </summary>
    public async Task<List<DunningRecordDto>> GetDunningHistoryAsync(
        int subscriptionId,
        CancellationToken cancellationToken)
    {
        var records = await _context.Set<DunningRecord>()
            .AsNoTracking()
            .Where(d => d.SubscriptionId == subscriptionId && !d.Subscription!.IsDeleted)
            .OrderByDescending(d => d.CreatedAt)
            .ToListAsync(cancellationToken);

        return records.Select(MapToDto).ToList();
    }

    /// <summary>
    /// Manually retry a dunning record (admin override).
    /// </summary>
    public async Task<DunningRecordDto> ManualRetryAsync(
        int dunningRecordId,
        CancellationToken cancellationToken)
    {
        var record = await _context.Set<DunningRecord>()
            .FirstOrDefaultAsync(d => d.Id == dunningRecordId, cancellationToken)
            ?? throw new InvalidOperationException($"Dunning record {dunningRecordId} not found");

        record.NextRetryDate = DateTime.UtcNow; // Immediate retry
        record.Notes += $"\nManual retry initiated by admin";

        _context.Set<DunningRecord>().Update(record);
        await _context.SaveChangesAsync(cancellationToken);

        _logger.LogInformation("Manual retry initiated: DunningId={Id}", dunningRecordId);

        return MapToDto(record);
    }

    /// <summary>
    /// Map DunningRecord entity to DTO.
    /// </summary>
    private static DunningRecordDto MapToDto(DunningRecord record)
    {
        return new DunningRecordDto
        {
            Id = record.Id,
            SubscriptionId = record.SubscriptionId,
            InvoiceId = record.InvoiceId,
            RetryAttempt = record.RetryAttempt,
            NextRetryDate = record.NextRetryDate,
            Status = record.Status.ToString(),
            Reason = record.Reason,
            InitialFailureDate = record.InitialFailureDate,
            IsExhausted = record.IsExhausted,
            OutstandingAmount = record.OutstandingAmount,
            RecoveredAmount = record.RecoveredAmount
        };
    }
}
