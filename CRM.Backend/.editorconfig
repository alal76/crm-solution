# EditorConfig for CRM Solution Backend
# https://editorconfig.org

root = false

[*.cs]
# ============================================================================
# StyleCop Rules - Suppressed (cosmetic / style-preference only)
# ============================================================================

# SA1512: Single-line comments should not be followed by blank line
# Rationale: Cosmetic preference, does not affect readability or correctness
dotnet_diagnostic.SA1512.severity = none

# SA1501: Statement should not be on a single line
# Rationale: Short guard clauses on single lines are idiomatic modern C#
dotnet_diagnostic.SA1501.severity = none

# SA1107: Code should not contain multiple statements on one line
# Rationale: Short related assignments on same line are acceptable
dotnet_diagnostic.SA1107.severity = none

# SA1500: Braces for multi-line statements should not share line
# Rationale: Expression-bodied members and compact patterns are acceptable
dotnet_diagnostic.SA1500.severity = none

# SA1502: Element should not be on a single line
# Rationale: Empty method bodies and short implementations on one line are acceptable
dotnet_diagnostic.SA1502.severity = none

# SA1514: Element documentation header should be preceded by blank line
# Rationale: Cosmetic only - enum values and properties don't need blank lines before docs
dotnet_diagnostic.SA1514.severity = none

# SA1407: Arithmetic expressions should declare precedence
# Rationale: Standard operator precedence is well understood by C# developers
dotnet_diagnostic.SA1407.severity = none

# SA1011: Closing square bracket should be followed by a space
# Rationale: False positives on nullable array syntax (byte[]?)
dotnet_diagnostic.SA1011.severity = none

# SA1507: Code should not contain multiple blank lines
# Rationale: Extra blank lines between logical sections aid readability
dotnet_diagnostic.SA1507.severity = none

# SA1642: Constructor summary documentation should begin with standard text
# Rationale: Overly prescriptive for constructor doc comments
dotnet_diagnostic.SA1642.severity = none

# SA1128: Put constructor initializers on their own line
# Rationale: Short base() calls on same line are acceptable
dotnet_diagnostic.SA1128.severity = none

# SA1310: Field names should not contain underscore
# Rationale: Static readonly constants with UPPER_CASE are acceptable
dotnet_diagnostic.SA1310.severity = none

# SA1119: Statement should not use unnecessary parenthesis
# Rationale: Extra parentheses can improve readability for complex expressions
dotnet_diagnostic.SA1119.severity = none

# SA1010: Opening square bracket should not be preceded by a space
# Rationale: False positives with collection expressions
dotnet_diagnostic.SA1010.severity = none

# SA1601: Partial elements should be documented
# Rationale: Partial classes documented at primary declaration only
dotnet_diagnostic.SA1601.severity = none

# SA1516: Elements should be separated by blank line
# Rationale: False positives in top-level Program.cs; cosmetic only
dotnet_diagnostic.SA1516.severity = none

# ============================================================================
# StyleCop Rules - Kept as suggestions (informational, not warnings)
# ============================================================================

# SA1201: Elements should appear in the correct order
# Rationale: Worth knowing about, but not blocking
dotnet_diagnostic.SA1201.severity = suggestion

# SA1402: File may only contain a single type
# Rationale: Supporting types near their consumer is acceptable
dotnet_diagnostic.SA1402.severity = suggestion

# SA1203: Constants should appear before fields
# Rationale: Grouping by logical concern is acceptable
dotnet_diagnostic.SA1203.severity = suggestion

# SA1214: Readonly fields should appear before non-readonly fields
# Rationale: Grouping by logical concern is acceptable
dotnet_diagnostic.SA1214.severity = suggestion

# SA1211: Using alias directives should be ordered alphabetically by alias name
# Rationale: Minor ordering preference
dotnet_diagnostic.SA1211.severity = suggestion

# ============================================================================
# Compiler Warnings - Suppressed
# ============================================================================

# CS1570: XML comment has badly formed XML
# Rationale: Many inherited XML doc comments have minor formatting issues
dotnet_diagnostic.CS1570.severity = suggestion

# CS1573: Parameter has no matching param tag in XML comment
# Rationale: Not all parameters need individual doc tags
dotnet_diagnostic.CS1573.severity = suggestion

# CS1587: XML comment is not placed on a valid language element
# Rationale: File-level comments and section separators are acceptable
dotnet_diagnostic.CS1587.severity = suggestion

# ============================================================================
# Test Projects - Relaxed rules
# Matches all .cs files under tests/ directories
# ============================================================================
[{*Tests*.cs,tests/**.cs}]
# CS8625: Cannot convert null literal to non-nullable reference type
# Rationale: Test mocking frequently passes null for non-nullable params
dotnet_diagnostic.CS8625.severity = none

# CS8604: Possible null reference argument
# Rationale: Test setups use nullable patterns that are safe in test context
dotnet_diagnostic.CS8604.severity = none

# CS8619: Nullability of reference types in return type doesn't match
# Rationale: Mock returns can have mismatched nullability
dotnet_diagnostic.CS8619.severity = none

# CS0219: Variable is assigned but its value is never used
# Rationale: Test variables for setup/arrangement
dotnet_diagnostic.CS0219.severity = none

# CS1998: Async method lacks 'await' operators
# Rationale: Test methods may be async for signature compatibility
dotnet_diagnostic.CS1998.severity = none

# CS0618: Member is obsolete
# Rationale: Tests may exercise deprecated codepaths intentionally
dotnet_diagnostic.CS0618.severity = none

# SA1111: Closing parenthesis should be on line of last parameter
# Rationale: Multi-line test assertions and mock setups use varied formatting
dotnet_diagnostic.SA1111.severity = none

# SA1025: Code should not contain multiple whitespace in a row
# Rationale: Alignment whitespace in test data tables is acceptable
dotnet_diagnostic.SA1025.severity = none

# SA1649: File name should match first type name
# Rationale: Test files may group related test classes
dotnet_diagnostic.SA1649.severity = none

# SA1129: Do not use default value type constructor
# Rationale: Test patterns may use explicit default()
dotnet_diagnostic.SA1129.severity = none

# xUnit1026: Theory methods should use all of their parameters
# Rationale: Parameterized tests may not use all data in every assertion
dotnet_diagnostic.xUnit1026.severity = none
