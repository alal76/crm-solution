# CRM Solution - Production Environment
# IMPORTANT: Fill in ALL values before deploying to production!
# Do NOT commit this file to source control!

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Use strong, unique passwords (20+ characters recommended)
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure random key: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ===========================================
# CORS / ALLOWED ORIGINS
# ===========================================
# Your production domain(s) - comma separated
ALLOWED_ORIGINS=https://your-production-domain.com

# ===========================================
# ENVIRONMENT
# ===========================================
ASPNETCORE_ENVIRONMENT=Production

# ===========================================
# OAUTH PROVIDERS (Configure if using social login)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
