# Generated by CRM CDT | {{ now }}
# Connectivity model: {{ db_auth_method }} | Secret store: {{ secret_store }}
# Reference: SPEC-INF-001-ConnectivitySecurityModel
#
# IMPORTANT — pre-requisites before applying this manifest:
{% if db_auth_method == 'k8s_secret' %}
#   Create the crm-secrets Secret:
#     kubectl create secret generic crm-secrets \
#       --from-literal=db-password='<STRONG_PASSWORD>' \
#       --from-literal=db-root-password='<ROOT_PASSWORD>' \
#       --from-literal=jwt-secret='<JWT_32_CHAR_KEY>' \
#       -n {{ profile_name }}-ns
{% elif db_auth_method == 'iam_aws' %}
#   Create an IAM Role for Service Account (IRSA):
#     eksctl create iamserviceaccount --name crm-api-sa \
#       --namespace {{ profile_name }}-ns --cluster <CLUSTER_NAME> \
#       --attach-role-arn {{ db_iam_role_arn }} --approve
#   Enable IAM auth on RDS:
#     aws rds modify-db-instance --db-instance-identifier <ID> \
#       --enable-iam-database-authentication
#   Grant the IAM role the rds_iam DB privilege for user {{ db_user | default('crm_user') }}
{% elif db_auth_method == 'iam_azure' %}
#   Assign Managed Identity to the AKS node pool or enable Workload Identity:
#     az aks update --resource-group <RG> --name <CLUSTER> --enable-workload-identity
#   Grant the Identity the 'mysql_native_password' login on Azure Database for MySQL.
#   Client ID: {{ db_managed_identity_client_id }}
{% elif db_auth_method == 'iam_gcp' %}
#   Bind Workload Identity for Cloud SQL:
#     gcloud iam service-accounts add-iam-policy-binding \
#       crm-api@{{ gcp_project_id }}.iam.gserviceaccount.com \
#       --role roles/iam.workloadIdentityUser \
#       --member "serviceAccount:{{ gcp_project_id }}.svc.id.goog[{{ profile_name }}-ns/crm-api-sa]"
#   Grant cloudsql.client role to the GSA.
{% elif db_auth_method == 'vault_dynamic' %}
#   Configure Vault database secrets engine and role for CRM:
#     vault write database/config/crm-mariadb plugin_name=mysql-database-plugin \
#       connection_url="{{'{{'}}username{{'}}'}}:{{'{{'}}password{{'}}'}}@tcp({{ db_host }}:3306)/" \
#       allowed_roles="crm-api-role" username="{{ db_user }}" password="<VAULT_ADMIN_PASS>"
#     vault write database/roles/crm-api-role db_name=crm-mariadb \
#       creation_statements="CREATE USER '{{'{{'}}name{{'}}'}}' IDENTIFIED BY '{{'{{'}}password{{'}}'}}'; \
#         GRANT ALL ON {{ db_name }}.* TO '{{'{{'}}name{{'}}'}}'" \
#       ttl="1h" max_ttl="24h"
#   Install and annotate the Vault Agent Injector (see vault_role annotation below).
{% elif db_auth_method == 'ssl_cert' %}
#   Create TLS secret from client certificate/key:
#     kubectl create secret generic crm-db-tls \
#       --from-file=tls.crt={{ db_ssl_cert_path }} \
#       --from-file=tls.key={{ db_ssl_key_path }} \
#       --from-file=ca.crt={{ db_ssl_ca_path }} \
#       -n {{ profile_name }}-ns
#   Create crm-secrets Secret (db-password still required with ssl_cert mode):
#     kubectl create secret generic crm-secrets \
#       --from-literal=db-password='<STRONG_PASSWORD>' \
#       --from-literal=jwt-secret='<JWT_32_CHAR_KEY>' \
#       -n {{ profile_name }}-ns
{% endif %}
# ─────────────────────────────────────────────────────────────────────────────

apiVersion: v1
kind: Namespace
metadata:
  name: {{ profile_name }}-ns
---
{% if db_auth_method in ('iam_aws', 'iam_azure', 'iam_gcp', 'vault_dynamic') %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: crm-api-sa
  namespace: {{ profile_name }}-ns
{% if db_auth_method == 'iam_aws' %}
  annotations:
    eks.amazonaws.com/role-arn: "{{ db_iam_role_arn }}"
{% elif db_auth_method == 'iam_azure' %}
  annotations:
    azure.workload.identity/client-id: "{{ db_managed_identity_client_id }}"
  labels:
    azure.workload.identity/use: "true"
{% elif db_auth_method == 'iam_gcp' %}
  annotations:
    iam.gke.io/gcp-service-account: "crm-api@{{ gcp_project_id }}.iam.gserviceaccount.com"
{% elif db_auth_method == 'vault_dynamic' %}
  annotations:
    vault.hashicorp.com/agent-inject: "true"
    vault.hashicorp.com/role: "{{ vault_role }}"
    vault.hashicorp.com/agent-inject-secret-db: "database/creds/crm-api-role"
    vault.hashicorp.com/agent-inject-template-db: |
      {{- '{{' -}} with secret "database/creds/crm-api-role" -}}
      ConnectionStrings__DefaultConnection=Server={{ db_host | default('crm-mariadb') }};Database={{ db_name | default('crm_db') }};User={{ '{{' }}.Data.username{{ '}}' }};Password={{ '{{' }}.Data.password{{ '}}' }};
      {{- '{{' -}} end -}}
{% endif %}
---
{% endif %}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crm-api
  namespace: {{ profile_name }}-ns
  labels:
    app: crm-api
    version: "{{ crm_version }}"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: crm-api
  template:
    metadata:
      labels:
        app: crm-api
{% if db_auth_method == 'vault_dynamic' %}
      annotations:
        vault.hashicorp.com/agent-inject: "true"
        vault.hashicorp.com/role: "{{ vault_role }}"
        vault.hashicorp.com/agent-inject-secret-db: "database/creds/crm-api-role"
{% endif %}
    spec:
{% if db_auth_method in ('iam_aws', 'iam_azure', 'iam_gcp', 'vault_dynamic') %}
      serviceAccountName: crm-api-sa
{% endif %}
      containers:
        - name: crm-api
          image: {{ image_prefix }}crm-api:{{ crm_version }}
          imagePullPolicy: Always
          ports:
            - containerPort: 5000
          env:
            - name: ASPNETCORE_ENVIRONMENT
              value: Production
{% if db_auth_method == 'k8s_secret' %}
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default('3306') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password=$(DB_PASSWORD);"
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crm-secrets
                  key: db-password
{% elif db_auth_method == 'ssl_cert' %}
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crm-secrets
                  key: db-password
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default('3306') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password=$(DB_PASSWORD);SslMode=VerifyCA;SslCert=/etc/crm/tls/tls.crt;SslKey=/etc/crm/tls/tls.key;SslCa=/etc/crm/tls/ca.crt;"
{% elif db_auth_method == 'iam_aws' %}
            # AWS RDS IAM auth: no password, token is generated by the SDK using the IAM role.
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default('3306') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};UseIAMAuthentication=true;SslMode=Required;"
{% elif db_auth_method == 'iam_azure' %}
            # Azure Managed Identity: no password, token obtained via IMDS using the MI client ID.
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default('3306') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Authentication=ActiveDirectoryManagedIdentity;SslMode=Required;"
{% elif db_auth_method == 'iam_gcp' %}
            # GCP Workload Identity + Cloud SQL Proxy sidecar (listening on 127.0.0.1:3306).
            - name: ConnectionStrings__DefaultConnection
              value: "Server=127.0.0.1;Port=3306;Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};SslMode=None;"
{% elif db_auth_method == 'vault_dynamic' %}
            # Vault Agent Injector writes credentials to /vault/secrets/db at runtime.
            # The entrypoint reads that file and constructs the connection string.
            - name: VAULT_CREDS_FILE
              value: "/vault/secrets/db"
{% else %}
            # Fallback: password from crm-secrets (create Secret before deploying)
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: crm-secrets
                  key: db-password
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default('3306') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password=$(DB_PASSWORD);"
{% endif %}
            - name: Jwt__Secret
              valueFrom:
                secretKeyRef:
                  name: crm-secrets
                  key: jwt-secret
            - name: Redis__ConnectionString
              value: "crm-redis:6379"
            - name: ASPNETCORE_URLS
              value: "http://+:5000"
          resources:
            requests:
              cpu: "250m"
              memory: "512Mi"
            limits:
              cpu: "1000m"
              memory: "1Gi"
          readinessProbe:
            httpGet:
              path: /health/ready
              port: 5000
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health/live
              port: 5000
            initialDelaySeconds: 30
            periodSeconds: 30
{% if db_auth_method == 'ssl_cert' %}
          volumeMounts:
            - name: db-tls
              mountPath: /etc/crm/tls
              readOnly: true
{% elif db_auth_method == 'vault_dynamic' %}
          volumeMounts:
            - name: vault-secrets
              mountPath: /vault/secrets
{% endif %}
{% if db_auth_method == 'iam_gcp' %}
        - name: cloud-sql-proxy
          image: gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.12.0
          args:
            - "--structured-logs"
            - "--port=3306"
            - "{{ db_cloud_sql_instance }}"
          securityContext:
            runAsNonRoot: true
          resources:
            requests:
              memory: "64Mi"
              cpu: "50m"
{% endif %}
{% if db_auth_method == 'ssl_cert' %}
      volumes:
        - name: db-tls
          secret:
            secretName: crm-db-tls
{% elif db_auth_method == 'vault_dynamic' %}
      volumes:
        - name: vault-secrets
          emptyDir:
            medium: Memory
{% endif %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crm-frontend
  namespace: {{ profile_name }}-ns
  labels:
    app: crm-frontend
    version: "{{ crm_version }}"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: crm-frontend
  template:
    metadata:
      labels:
        app: crm-frontend
    spec:
      containers:
        - name: crm-frontend
          image: {{ image_prefix }}crm-frontend:{{ crm_version }}
          imagePullPolicy: Always
          ports:
            - containerPort: 80
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
          readinessProbe:
            httpGet:
              path: /
              port: 80
            initialDelaySeconds: 10
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: crm-api-svc
  namespace: {{ profile_name }}-ns
spec:
  selector:
    app: crm-api
  ports:
    - protocol: TCP
      port: 5000
      targetPort: 5000
---
apiVersion: v1
kind: Service
metadata:
  name: crm-frontend-svc
  namespace: {{ profile_name }}-ns
spec:
  selector:
    app: crm-frontend
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
---
{% if ssl_enabled or true %}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: crm-ingress
  namespace: {{ profile_name }}-ns
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "50m"
spec:
  ingressClassName: nginx
  rules:
    - host: {{ domain_name | default('crm.example.com') }}
      http:
        paths:
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: crm-api-svc
                port:
                  number: 5000
          - path: /
            pathType: Prefix
            backend:
              service:
                name: crm-frontend-svc
                port:
                  number: 80
{% if ssl_enabled %}
  tls:
    - hosts:
        - {{ domain_name | default('crm.example.com') }}
      secretName: crm-tls-cert
{% endif %}
---
{% endif %}
# NetworkPolicy: restrict DB access to api pods only
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: crm-db-access
  namespace: {{ profile_name }}-ns
spec:
  podSelector:
    matchLabels:
      app: crm-mariadb
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: crm-api
      ports:
        - protocol: TCP
          port: 3306

