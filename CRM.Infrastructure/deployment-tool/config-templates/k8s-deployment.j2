# Generated by CRM CDT | {{ now }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crm-api
  namespace: {{ profile_name }}-ns
spec:
  replicas: 2
  selector:
    matchLabels:
      app: crm-api
  template:
    metadata:
      labels:
        app: crm-api
    spec:
      containers:
        - name: crm-api
          image: ghcr.io/youorg/crm-api:{{ crm_version }}
          ports:
            - containerPort: 5000
          env:
            - name: ASPNETCORE_ENVIRONMENT
              value: Production
            - name: ConnectionStrings__DefaultConnection
              value: "Server={{ db_host | default('crm-mariadb') }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password={{ db_password }};"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: crm-frontend
  namespace: {{ profile_name }}-ns
spec:
  replicas: 2
  selector:
    matchLabels:
      app: crm-frontend
  template:
    metadata:
      labels:
        app: crm-frontend
    spec:
      containers:
        - name: crm-frontend
          image: ghcr.io/youorg/crm-frontend:{{ crm_version }}
          ports:
            - containerPort: 80
