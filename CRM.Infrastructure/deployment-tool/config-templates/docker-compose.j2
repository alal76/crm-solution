# Generated by CRM CDT on {{ now }}
# Profile: {{ profile_name }} | Version: {{ crm_version }}
# vim: set ft=yaml:

services:
  crm-api:
    image: {{ image_registry | default('ghcr.io') }}/{{ image_org | default('crm') }}/crm-api:{{ crm_version | default('latest') }}
    container_name: crm-api
    restart: unless-stopped
    environment:
      - ASPNETCORE_ENVIRONMENT=Production
      - ASPNETCORE_URLS=http://+:5000
      - ConnectionStrings__DefaultConnection=Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default(3306) }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password={{ db_password }};
      - Jwt__Secret={{ jwt_secret }}
      - Jwt__Issuer=CRM.Api
      - Jwt__Audience=CRM.Client
      - Redis__ConnectionString=crm-redis:6379{{ ':' + redis_password if redis_password else '' }}
      - ADMIN_EMAIL={{ admin_email | default(admin_admin_email | default('admin@crm.local')) }}
      - ADMIN_PASSWORD={{ admin_password | default(admin_admin_password | default('Admin@123')) }}
      - ADMIN_USERNAME={{ admin_username | default(admin_admin_username | default('admin')) }}
      - RateLimiting__EnableEndpointRateLimiting={{ rate_limiting_enabled | default('true') }}
{% if providers.get('search_provider') == 'meilisearch' %}
      - FeatureManagement__UseExternalSearch=true
      - Providers__Search__Type=Meilisearch
      - Providers__Search__Meilisearch__Url=http://crm-meilisearch:7700
      - Providers__Search__Meilisearch__ApiKey={{ meilisearch_master_key | default('masterKey') }}
{% endif %}
{% if providers.get('chat_provider') == 'chatwoot' %}
      - FeatureManagement__UseExternalChat=true
      - Providers__Chat__Type=Chatwoot
      - Providers__Chat__Chatwoot__BaseUrl=http://crm-chatwoot:3000
      - Providers__Chat__Chatwoot__ApiKey={{ chatwoot_api_key | default('') }}
      - Providers__Chat__Chatwoot__AccountId={{ chatwoot_account_id | default('1') }}
{% endif %}
{% if providers.get('notification_provider') == 'novu' %}
      - FeatureManagement__UseExternalNotifications=true
      - Providers__Notifications__Type=Novu
      - Providers__Notifications__Novu__ApiKey={{ novu_api_key | default('') }}
      - Providers__Notifications__Novu__BaseUrl=http://crm-novu:3000
{% endif %}
{% if providers.get('analytics_provider') == 'superset' %}
      - FeatureManagement__UseExternalAnalytics=true
      - Providers__Analytics__Type=Superset
      - Providers__Analytics__Superset__Url=http://crm-superset:8088
{% endif %}
{% if providers.get('signature_provider') == 'docuseal' %}
      - FeatureManagement__UseExternalSignatures=true
      - Providers__Signatures__Type=DocuSeal
      - Providers__Signatures__DocuSeal__Url=http://crm-docuseal:3000
      - Providers__Signatures__DocuSeal__ApiKey={{ docuseal_api_key | default('') }}
{% endif %}
{% if providers.get('integration_provider') == 'n8n' %}
      - FeatureManagement__UseExternalIntegrations=true
      - Providers__Integrations__Type=N8n
      - Providers__Integrations__N8n__BaseUrl=http://crm-n8n:5678
      - Providers__Integrations__N8n__ApiKey={{ n8n_api_key | default('') }}
{% endif %}
{% if providers.get('ai_provider') == 'ollama' %}
      - FeatureManagement__UseExternalAI=true
      - Providers__AI__Type=Ollama
      - Providers__AI__Ollama__Url=http://crm-ollama:11434
      - Providers__AI__Ollama__Model={{ ollama_model | default('llama3.1:8b') }}
{% elif providers.get('ai_provider') == 'openai' %}
      - FeatureManagement__UseExternalAI=true
      - Providers__AI__Type=OpenAI
      - Providers__AI__OpenAI__ApiKey={{ openai_api_key | default('') }}
      - Providers__AI__OpenAI__Model={{ openai_model | default('gpt-4o') }}
{% elif providers.get('ai_provider') == 'azure_openai' %}
      - FeatureManagement__UseExternalAI=true
      - Providers__AI__Type=AzureOpenAI
      - Providers__AI__AzureOpenAI__Endpoint={{ azure_openai_endpoint | default('') }}
      - Providers__AI__AzureOpenAI__ApiKey={{ azure_openai_api_key | default('') }}
      - Providers__AI__AzureOpenAI__DeploymentName={{ azure_openai_deployment | default('gpt-4o') }}
{% elif providers.get('ai_provider') == 'anthropic' %}
      - FeatureManagement__UseExternalAI=true
      - Providers__AI__Type=Anthropic
      - Providers__AI__Anthropic__ApiKey={{ anthropic_api_key | default('') }}
{% endif %}
    ports:
      - "{{ api_port | default('5000') }}:5000"
    depends_on:
      crm-mariadb:
        condition: service_healthy
      crm-redis:
        condition: service_started
    networks:
      - crm-network
{% if ssl_enabled %}
    volumes:
      - ssl_certs:/etc/ssl/crm:ro
{% endif %}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:5000/health"]
      interval: 30s
      timeout: 10s
      retries: 5

  crm-frontend:
    image: {{ image_registry | default('ghcr.io') }}/{{ image_org | default('crm') }}/crm-frontend:{{ crm_version | default('latest') }}
    container_name: crm-frontend
    restart: unless-stopped
    ports:
{% if ssl_enabled %}
      - "443:443"
      - "80:80"
{% else %}
      - "{{ frontend_port | default('80') }}:80"
{% endif %}
    depends_on:
      - crm-api
    networks:
      - crm-network
{% if ssl_enabled %}
    volumes:
      - ssl_certs:/etc/ssl/crm:ro
{% endif %}

  crm-mariadb:
    image: mariadb:{{ db_version | default('10.11') }}
    container_name: crm-mariadb
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD={{ db_root_password | default(generate_password(24)) }}
      - MYSQL_DATABASE={{ db_name | default('crm_db') }}
      - MYSQL_USER={{ db_user | default('crm_user') }}
      - MYSQL_PASSWORD={{ db_password }}
    volumes:
      - mariadb_data:/var/lib/mysql
    networks:
      - crm-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 10

  crm-redis:
    image: redis:7-alpine
    container_name: crm-redis
    restart: unless-stopped
{% if redis_password %}
    command: redis-server --requirepass {{ redis_password }}
{% endif %}
    volumes:
      - redis_data:/data
    networks:
      - crm-network

{% if providers.get('search_provider') == 'meilisearch' %}
  crm-meilisearch:
    image: getmeili/meilisearch:v1.6
    container_name: crm-meilisearch
    restart: unless-stopped
    environment:
      - MEILI_MASTER_KEY={{ meilisearch_master_key | default('masterKey') }}
      - MEILI_ENV={{ 'production' if not is_development else 'development' }}
    volumes:
      - meilisearch_data:/meili_data
    networks:
      - crm-network
{% endif %}

{% if providers.get('ai_provider') == 'ollama' %}
  crm-ollama:
    image: ollama/ollama:latest
    container_name: crm-ollama
    restart: unless-stopped
    volumes:
      - ollama_data:/root/.ollama
    networks:
      - crm-network
{% endif %}

{% if providers.get('chat_provider') == 'chatwoot' %}
  crm-chatwoot:
    image: chatwoot/chatwoot:latest
    container_name: crm-chatwoot
    restart: unless-stopped
    environment:
      - SECRET_KEY_BASE={{ chatwoot_secret_key | default(generate_password(64)) }}
      - FRONTEND_URL=http://localhost:3000
      - RAILS_ENV=production
      - DATABASE_URL=postgres://{{ db_user | default('crm_user') }}:{{ db_password }}@crm-postgres:5432/chatwoot
      - REDIS_URL=redis://crm-redis:6379
    depends_on:
      - crm-redis
    volumes:
      - chatwoot_data:/app/storage
    networks:
      - crm-network
{% endif %}

{% if providers.get('notification_provider') == 'novu' %}
  crm-novu:
    image: ghcr.io/novuhq/novu/api:latest
    container_name: crm-novu
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - REDIS_HOST=crm-redis
      - JWT_SECRET={{ novu_jwt_secret | default(generate_token(32)) }}
      - API_KEY={{ novu_api_key | default('') }}
    depends_on:
      - crm-redis
    networks:
      - crm-network
{% endif %}

{% if providers.get('analytics_provider') == 'superset' %}
  crm-superset:
    image: apache/superset:latest
    container_name: crm-superset
    restart: unless-stopped
    environment:
      - SUPERSET_SECRET_KEY={{ superset_secret_key | default(generate_password(42)) }}
      - SUPERSET_SQLALCHEMY_DATABASE_URI=mysql://{{ db_user | default('crm_user') }}:{{ db_password }}@crm-mariadb:3306/superset
    volumes:
      - superset_data:/app/superset_home
    networks:
      - crm-network
{% endif %}

{% if providers.get('signature_provider') == 'docuseal' %}
  crm-docuseal:
    image: docuseal/docuseal:latest
    container_name: crm-docuseal
    restart: unless-stopped
    environment:
      - SECRET_KEY_BASE={{ docuseal_secret_key | default(generate_password(64)) }}
    volumes:
      - docuseal_data:/data
    networks:
      - crm-network
{% endif %}

{% if providers.get('integration_provider') == 'n8n' %}
  crm-n8n:
    image: n8nio/n8n:latest
    container_name: crm-n8n
    restart: unless-stopped
    environment:
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER={{ n8n_username | default('admin') }}
      - N8N_BASIC_AUTH_PASSWORD={{ n8n_password | default(generate_password(16)) }}
      - WEBHOOK_URL=http://crm-n8n:5678/
    volumes:
      - n8n_data:/home/node/.n8n
    networks:
      - crm-network
{% endif %}

networks:
  crm-network:
    driver: bridge

volumes:
  mariadb_data:
  redis_data:
{% if ssl_enabled %}
  ssl_certs:
{% endif %}
{% if providers.get('search_provider') == 'meilisearch' %}
  meilisearch_data:
{% endif %}
{% if providers.get('ai_provider') == 'ollama' %}
  ollama_data:
{% endif %}
{% if providers.get('chat_provider') == 'chatwoot' %}
  chatwoot_data:
{% endif %}
{% if providers.get('analytics_provider') == 'superset' %}
  superset_data:
{% endif %}
{% if providers.get('signature_provider') == 'docuseal' %}
  docuseal_data:
{% endif %}
{% if providers.get('integration_provider') == 'n8n' %}
  n8n_data:
{% endif %}
