# Generated by CRM CDT | {{ now }}
# Connectivity model: {{ db_auth_method }} | Secret store: {{ secret_store }}
# Reference: SPEC-INF-001-ConnectivitySecurityModel
#
# IMPORTANT — credentials are NEVER inlined here.
# All sensitive values must be stored in Kubernetes Secrets before deploying.
#
{% if db_auth_method == 'k8s_secret' or db_auth_method == 'ssl_cert' %}
# Create the required Secret first:
#   kubectl create secret generic crm-secrets \
#     --from-literal=db-password='<STRONG_PASSWORD>' \
#     --from-literal=jwt-secret='<JWT_32_CHAR_KEY>' \
#     -n {{ profile_name }}-ns
{% elif db_auth_method == 'iam_aws' %}
# AWS IRSA — no DB password needed; ensure the IAM role ARN is set:
#   db.iamRoleArn: {{ db_iam_role_arn }}
# And that IRSA is configured on the cluster for the crm-api-sa ServiceAccount.
{% elif db_auth_method == 'iam_azure' %}
# Azure Workload Identity — no DB password needed; ensure Managed Identity is assigned.
#   db.managedIdentityClientId: {{ db_managed_identity_client_id }}
{% elif db_auth_method == 'iam_gcp' %}
# GCP Workload Identity + Cloud SQL Proxy sidecar — no DB password needed.
#   db.cloudSqlInstance: {{ db_cloud_sql_instance }}
#   db.gcpProjectId: {{ gcp_project_id }}
{% elif db_auth_method == 'vault_dynamic' %}
# Vault Dynamic Credentials — no static password; Vault Agent Injector handles it.
#   vault.address: {{ vault_address }}
#   vault.role: {{ vault_role }}
{% endif %}

global:
  imageTag: "{{ crm_version }}"
  domain: "{{ domain_name | default('crm.example.com') }}"
  namespace: "{{ profile_name }}-ns"

api:
  replicaCount: 2
  image:
    repository: {{ image_prefix }}crm-api
    tag: "{{ crm_version }}"
    pullPolicy: Always

  # DB connectivity — method: {{ db_auth_method }}
  db:
    host: "{{ db_host | default('crm-mariadb') }}"
    port: {{ db_port | default('3306') }}
    name: "{{ db_name | default('crm_db') }}"
    user: "{{ db_user | default('crm_user') }}"
    authMethod: "{{ db_auth_method }}"
{% if db_auth_method in ('k8s_secret', 'ssl_cert') %}
    # Password sourced from existingSecret — never set dbPassword here.
    existingSecret: "crm-secrets"
    existingSecretPasswordKey: "db-password"
{% elif db_auth_method == 'iam_aws' %}
    iamRoleArn: "{{ db_iam_role_arn }}"
    useIAMAuthentication: true
    sslMode: "Required"
{% elif db_auth_method == 'iam_azure' %}
    managedIdentityClientId: "{{ db_managed_identity_client_id }}"
    sslMode: "Required"
{% elif db_auth_method == 'iam_gcp' %}
    cloudSqlInstance: "{{ db_cloud_sql_instance }}"
    gcpProjectId: "{{ gcp_project_id }}"
    cloudSqlProxy:
      enabled: true
      image: "gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.12.0"
{% elif db_auth_method == 'vault_dynamic' %}
    vault:
      enabled: true
      address: "{{ vault_address }}"
      role: "{{ vault_role }}"
      secretPath: "database/creds/crm-api-role"
{% endif %}
{% if db_auth_method == 'ssl_cert' %}
    tls:
      enabled: true
      existingSecret: "crm-db-tls"  # kubectl create secret generic crm-db-tls --from-file=...
      certFile: "tls.crt"
      keyFile: "tls.key"
      caFile: "ca.crt"
{% endif %}

  # JWT — sourced from existingSecret; never inline the secret value.
  jwt:
    existingSecret: "crm-secrets"
    existingSecretKey: "jwt-secret"
    issuer: "CRM.Api"
    audience: "CRM.Client"

  resources:
    requests:
      cpu: "250m"
      memory: "512Mi"
    limits:
      cpu: "1000m"
      memory: "1Gi"

{% if db_auth_method in ('iam_aws', 'iam_azure', 'iam_gcp', 'vault_dynamic') %}
  serviceAccount:
    create: true
    name: "crm-api-sa"
{% if db_auth_method == 'iam_aws' %}
    annotations:
      eks.amazonaws.com/role-arn: "{{ db_iam_role_arn }}"
{% elif db_auth_method == 'iam_azure' %}
    annotations:
      azure.workload.identity/client-id: "{{ db_managed_identity_client_id }}"
    labels:
      azure.workload.identity/use: "true"
{% elif db_auth_method == 'iam_gcp' %}
    annotations:
      iam.gke.io/gcp-service-account: "crm-api@{{ gcp_project_id }}.iam.gserviceaccount.com"
{% elif db_auth_method == 'vault_dynamic' %}
    annotations:
      vault.hashicorp.com/agent-inject: "true"
      vault.hashicorp.com/role: "{{ vault_role }}"
{% endif %}
{% else %}
  serviceAccount:
    create: false
{% endif %}

frontend:
  replicaCount: 2
  image:
    repository: {{ image_prefix }}crm-frontend
    tag: "{{ crm_version }}"
    pullPolicy: Always
  resources:
    requests:
      cpu: "100m"
      memory: "128Mi"
    limits:
      cpu: "500m"
      memory: "512Mi"

mariadb:
  enabled: true
  auth:
    database: "{{ db_name | default('crm_db') }}"
    username: "{{ db_user | default('crm_user') }}"
    # Password sourced from existingSecret — never set password here.
    existingSecret: "crm-secrets"
    existingSecretPasswordKey: "db-password"
    existingSecretRootPasswordKey: "db-root-password"

redis:
  enabled: true
  auth:
    # Password sourced from existingSecret if redis is auth-enabled.
    existingSecret: "crm-secrets"
    existingSecretPasswordKey: "redis-password"

ingress:
  enabled: true
  className: "nginx"
  host: "{{ domain_name | default('crm.example.com') }}"
{% if ssl_enabled %}
  tls:
    enabled: true
    secretName: "crm-tls-cert"
{% else %}
  tls:
    enabled: false
{% endif %}

networkPolicy:
  enabled: true
  # Restrict MariaDB access to api pods only (SPEC-INF-001 § NetworkPolicy)

admin:
  email: "{{ admin_email | default('admin@crm.local') }}"
  # Admin password sourced from existingSecret — never inline.
  existingSecret: "crm-secrets"
  existingSecretPasswordKey: "admin-password"

