# Generated by CRM CDT | {{ now }}
global:
  imageTag: "{{ crm_version }}"
  domain: "{{ domain_name | default('crm.example.com') }}"

api:
  replicaCount: 2
  image:
    repository: {{ image_prefix }}crm-api
    tag: "{{ crm_version }}"
  env:
    jwtSecret: "{{ jwt_secret }}"
    dbHost: "{{ db_host | default('crm-mariadb') }}"
    dbName: "{{ db_name | default('crm_db') }}"
    dbUser: "{{ db_user | default('crm_user') }}"
    dbPassword: "{{ db_password }}"

frontend:
  replicaCount: 2
  image:
    repository: {{ image_prefix }}crm-frontend
    tag: "{{ crm_version }}"

mariadb:
  enabled: true
  auth:
    database: "{{ db_name | default('crm_db') }}"
    username: "{{ db_user | default('crm_user') }}"
    password: "{{ db_password }}"

redis:
  enabled: true
