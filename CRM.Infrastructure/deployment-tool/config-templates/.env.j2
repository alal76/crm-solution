# CRM Solution - Environment Variables
# Generated by CRM CDT on {{ now }}
# Profile: {{ profile_name }}
#
# ── CONNECTIVITY SECURITY MODEL (SPEC-INF-001) ────────────────────────────────
# DB Auth Method : {{ db_auth_method }}
# Secret Store   : {{ secret_store }}
# ─────────────────────────────────────────────────────────────────────────────
# Dollar signs ($) are escaped as ($$) to prevent Docker Compose interpolation.

# ── Runtime ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
COMPOSE_PROJECT_NAME=crm-deployment
CRM_VERSION={{ crm_version | default('latest') }}
DOMAIN_NAME={{ domain_name | default('localhost') }}
TIMEZONE=UTC

# ── Database ──────────────────────────────────────────────────────
DatabaseProvider={{ db_provider | default('mariadb') }}
DB_HOST={{ db_host | default('crm-mariadb') }}
DB_PORT={{ db_port | default('3306') }}
DB_NAME={{ db_name | default('crm_db') }}
DB_USER={{ db_user | default('crm_user') }}
DB_AUTH_METHOD={{ db_auth_method }}

{% if db_auth_method == 'password' %}
# PASSWORD AUTH: credentials stored in this file.
# Ensure this file has chmod 600 and is NEVER committed to version control.
DB_PASSWORD="{{ docker_escape(db_password) }}"
DB_ROOT_PASSWORD="{{ docker_escape(db_root_password) }}"
MARIADB_ROOT_PASSWORD="{{ docker_escape(db_root_password) }}"
# ASP.NET Core style — used directly by the crm-api container
ConnectionStrings__DefaultConnection="Server={{ db_host | default('crm-mariadb') }};Port={{ db_port | default(3306) }};Database={{ db_name | default('crm_db') }};User={{ db_user | default('crm_user') }};Password={{ docker_escape(db_password) }};"
{% elif db_auth_method == 'docker_secret' %}
# DOCKER SECRET AUTH: no password in this file.
# Create the Docker secret before deploying:
#   printf 'YOUR_STRONG_PASSWORD' | docker secret create crm_db_password -
#   printf 'YOUR_ROOT_PASSWORD'   | docker secret create crm_db_root_password -
# The container entrypoint reads /run/secrets/crm_db_password at startup.
{% elif db_auth_method == 'k8s_secret' %}
# K8S SECRET AUTH: password managed by the External Secrets Operator.
# Ensure ESO SecretStore and ExternalSecret objects are applied.
# See kubernetes/05-external-secrets.yaml
{% elif db_auth_method == 'ssl_cert' %}
# mTLS CERT AUTH: no password required.
# Mount the following client certificates into the API container:
DB_SSL_CERT_PATH={{ db_ssl_cert_path }}
DB_SSL_KEY_PATH={{ db_ssl_key_path }}
DB_SSL_CA_PATH={{ db_ssl_ca_path }}
# MariaDB user must require: REQUIRE X509
{% elif db_auth_method == 'iam_aws' %}
# AWS RDS IAM AUTH: no static password — IAM role generates 15-min tokens.
# Prerequisites:
#   1. RDS instance has IAM authentication enabled.
#   2. DB user requires: GRANT rds_iam TO '{{ db_user }}'@'%';
#   3. EKS/ECS task role has: rds-db:connect on the RDS resource ARN.
#   4. Download RDS CA bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA_PATH={{ db_ssl_ca_path | default('/certs/rds-ca.pem') }}
{% if db_iam_role_arn %}
DB_IAM_ROLE_ARN={{ db_iam_role_arn }}
{% endif %}
{% elif db_auth_method == 'iam_azure' %}
# AZURE MANAGED IDENTITY AUTH: no static password — Entra ID issues tokens.
# Prerequisites:
#   1. Azure MySQL Flexible Server must have Entra authentication enabled.
#   2. The AKS Managed Identity must have MySQL 'Contributor' role.
#   3. Connection string uses: Authentication=ActiveDirectoryManagedIdentity
{% if db_managed_identity_client_id %}
AZURE_MI_CLIENT_ID={{ db_managed_identity_client_id }}
{% endif %}
{% elif db_auth_method == 'iam_gcp' %}
# GCP WORKLOAD IDENTITY + CLOUD SQL PROXY AUTH: no static password.
# The Cloud SQL Auth Proxy sidecar runs in the pod and exposes 127.0.0.1:3306.
# Prerequisites:
#   1. GKE cluster has Workload Identity enabled.
#   2. KSA crm-api is annotated with the GCP service account.
#   3. GCP SA has roles/cloudsql.client on {{ db_cloud_sql_instance }}.
{% if db_cloud_sql_instance %}
CLOUD_SQL_INSTANCE={{ db_cloud_sql_instance }}
{% endif %}
{% elif db_auth_method == 'vault_dynamic' %}
# VAULT DYNAMIC CREDENTIALS: ephemeral username+password, auto-rotated by Vault.
# Prerequisites:
#   1. Vault is running at {{ vault_address }}
#   2. Vault DB secrets engine configured for {{ db_host }}
#   3. Vault K8s auth role '{{ vault_role }}' bound to sa-crm-api
VAULT_ADDR={{ vault_address }}
VAULT_ROLE={{ vault_role }}
VAULT_KV_PATH={{ vault_kv_path }}
{% endif %}

# ── JWT ───────────────────────────────────────────────────────────
{% if secret_store == 'env_file' %}
JWT_SECRET="{{ docker_escape(jwt_secret) }}"
{% else %}
# JWT_SECRET is managed by {{ secret_store }} — not set here.
# {% if secret_store == 'docker_secret' %}Secret name: crm_jwt_secret{% endif %}
# {% if secret_store == 'vault' %}Vault path: {{ vault_kv_path }}/jwt_secret{% endif %}
# {% if secret_store == 'aws_secrets_manager' %}AWS path: {{ aws_secret_prefix }}jwt_secret{% endif %}
# {% if secret_store == 'azure_key_vault' %}Key Vault: {{ azure_kv_url }}{% endif %}
# {% if secret_store == 'gcp_secret_manager' %}GCP project: {{ gcp_project_id }}{% endif %}
{% endif %}
JWT_ISSUER=CRM.Api
JWT_AUDIENCE=CRM.Client
Jwt__Issuer=CRM.Api
Jwt__Audience=CRM.Client
{% if secret_store == 'env_file' %}
Jwt__Secret="{{ docker_escape(jwt_secret) }}"
{% endif %}

# ── Admin Seed ────────────────────────────────────────────────────
ADMIN_USERNAME={{ admin_username | default(admin_admin_username | default('admin')) }}
ADMIN_EMAIL={{ admin_email | default(admin_admin_email | default('admin@crm.local')) }}
{% if secret_store == 'env_file' %}
ADMIN_PASSWORD="{{ docker_escape(admin_password | default(admin_admin_password | default('Admin@123'))) }}"
{% else %}
# ADMIN_PASSWORD managed by {{ secret_store }}
{% endif %}

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=crm-redis
REDIS_PORT=6379
REDIS_ENABLED=true
REDIS_INSTANCE=crm_
# ASP.NET Core style
Redis__Enabled=true
Redis__InstanceName=crm_
{% if redis_password %}
{% if secret_store == 'env_file' %}
REDIS_PASSWORD="{{ docker_escape(redis_password) }}"
Redis__ConnectionString=crm-redis:6379,password={{ docker_escape(redis_password) }}
{% else %}
# REDIS_PASSWORD managed by {{ secret_store }}
Redis__ConnectionString=crm-redis:6379
{% endif %}
{% else %}
Redis__ConnectionString=crm-redis:6379
{% endif %}

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMITING_ENABLED={{ rate_limiting_enabled | default('false') }}
RateLimiting__EnableEndpointRateLimiting={{ rate_limiting_enabled | default('false') }}

# ── Workflow Worker ───────────────────────────────────────────────
SKIP_WORKFLOW_WORKER=false

