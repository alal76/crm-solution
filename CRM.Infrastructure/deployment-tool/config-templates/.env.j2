# CRM Solution - Environment Variables
# Generated by CRM CDT on {{ now }}
# Profile: {{ profile_name }}
#
# Dollar signs ($) are escaped as ($$) to prevent Docker Compose interpolation.

# ── Runtime ───────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
CRM_VERSION={{ crm_version | default('latest') }}
DOMAIN_NAME={{ domain_name | default('localhost') }}

# ── Database ──────────────────────────────────────────────────────
DB_HOST={{ db_host | default('crm-mariadb') }}
DB_PORT={{ db_port | default('3306') }}
DB_NAME={{ db_name | default('crm_db') }}
DB_USER={{ db_user | default('crm_user') }}
DB_PASSWORD="{{ docker_escape(db_password) }}"
DB_ROOT_PASSWORD="{{ docker_escape(db_root_password) }}"

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET="{{ docker_escape(jwt_secret) }}"
JWT_ISSUER=CRM.Api
JWT_AUDIENCE=CRM.Client

# ── Admin Seed ────────────────────────────────────────────────────
ADMIN_USERNAME={{ admin_username | default(admin_admin_username | default('admin')) }}
ADMIN_EMAIL={{ admin_email | default(admin_admin_email | default('admin@crm.local')) }}
ADMIN_PASSWORD="{{ docker_escape(admin_password | default(admin_admin_password | default('Admin@123'))) }}"

# ── Redis ─────────────────────────────────────────────────────────
{% if redis_password %}
REDIS_PASSWORD="{{ docker_escape(redis_password) }}"
{% endif %}

# ── Search ────────────────────────────────────────────────────────
{% if providers.get('search_provider') == 'meilisearch' %}
MEILI_MASTER_KEY="{{ docker_escape(meilisearch_master_key | default('masterKey')) }}"
{% endif %}

# ── Chat ──────────────────────────────────────────────────────────
{% if providers.get('chat_provider') == 'chatwoot' %}
CHATWOOT_API_KEY="{{ docker_escape(chatwoot_api_key | default('')) }}"
CHATWOOT_SECRET_KEY="{{ docker_escape(chatwoot_secret_key | default('')) }}"
{% endif %}

# ── Notifications ─────────────────────────────────────────────────
{% if providers.get('notification_provider') == 'novu' %}
NOVU_API_KEY="{{ docker_escape(novu_api_key | default('')) }}"
{% endif %}

# ── Analytics ─────────────────────────────────────────────────────
{% if providers.get('analytics_provider') == 'superset' %}
SUPERSET_SECRET_KEY="{{ docker_escape(superset_secret_key | default('')) }}"
SUPERSET_ADMIN_PASSWORD="{{ docker_escape(superset_admin_password | default('')) }}"
{% endif %}

# ── Signatures ────────────────────────────────────────────────────
{% if providers.get('signature_provider') == 'docuseal' %}
DOCUSEAL_API_KEY="{{ docker_escape(docuseal_api_key | default('')) }}"
DOCUSEAL_SECRET_KEY="{{ docker_escape(docuseal_secret_key | default('')) }}"
{% endif %}

# ── AI ────────────────────────────────────────────────────────────
{% if providers.get('ai_provider') == 'ollama' %}
OLLAMA_MODEL={{ ollama_model | default('llama3.1:8b') }}
{% elif providers.get('ai_provider') == 'openai' %}
OPENAI_API_KEY="{{ docker_escape(openai_api_key | default('')) }}"
{% elif providers.get('ai_provider') == 'anthropic' %}
ANTHROPIC_API_KEY="{{ docker_escape(anthropic_api_key | default('')) }}"
{% endif %}

# ── Integrations ──────────────────────────────────────────────────
{% if providers.get('integration_provider') == 'n8n' %}
N8N_API_KEY="{{ docker_escape(n8n_api_key | default('')) }}"
{% endif %}
