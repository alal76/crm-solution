# ============================================================================
# CRM FRONTEND ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this file to .env for local development.
# DO NOT commit .env to source control.
#
# IMPORTANT: For production deployments, the .env.production file should have
# REACT_APP_API_URL set to EMPTY to enable runtime URL detection.
# ============================================================================

# API Configuration
# For local development only - leave empty in .env.production for runtime detection
REACT_APP_API_URL=http://localhost:5000/api

# OAuth Configuration (Optional)
# Get these from Google Cloud Console and Azure Portal
# Leave blank to disable OAuth and use only email/password login
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=
REACT_APP_MICROSOFT_TENANT_ID=

# Development settings
NODE_ENV=development
DANGEROUSLY_DISABLE_HOST_CHECK=true
