{
  "name": "crm-frontend",
  "version": "0.0.24",
  "description": "CRM Frontend - Enterprise Customer Relationship Management System",
  "private": true,
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "webpack-dev-server": "^5.2.1",
    "cookie": "^0.7.0",
    "jsonpath": "^1.1.1"
  },
  "dependencies": {
    "@craco/craco": "^7.1.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@microsoft/signalr": "^8.0.17",
    "@mui/icons-material": "^5.14.15",
    "@mui/lab": "^5.0.0-alpha.61",
    "@mui/material": "^5.14.15",
    "@mui/x-data-grid": "^7.3.0",
    "@react-oauth/google": "^0.12.1",
    "ajv": "^8.17.1",
    "axios": "^1.6.0",
    "dompurify": "^3.3.1",
    "formik": "^2.4.5",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^6.18.0",
    "recharts": "^2.10.3",
    "yup": "^1.3.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "msw": "^1.3.5",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "build:prod": "craco build && npm run validate:build",
    "build:analyze": "GENERATE_SOURCEMAP=true craco build && npx source-map-explorer 'build/static/js/*.js'",
    "build:fast": "GENERATE_SOURCEMAP=false CI=true craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "version:major": "node ../update-version.js major",
    "version:minor": "node ../update-version.js minor",
    "version:patch": "node ../update-version.js patch",
    "clean": "rm -rf build node_modules/.cache",
    "validate:env": "node -e \"const fs=require('fs'); const env=fs.readFileSync('.env.production','utf8'); if(env.includes('REACT_APP_API_URL=http')) { console.error('ERROR: .env.production has hardcoded URL'); process.exit(1); } console.log('✓ .env.production is valid');\"",
    "validate:build": "if grep -rE 'localhost:[0-9]{4}|192\\.168\\.[0-9]+\\.[0-9]+:[0-9]+' build/static/js/*.js 2>/dev/null | grep -v '//' | head -1; then echo 'ERROR: Hardcoded URLs in bundle'; exit 1; fi && echo '✓ Build validated'",
    "prebuild": "npm run validate:env || true"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "react-hooks/exhaustive-deps": "off",
      "@typescript-eslint/no-unused-vars": "off",
      "import/no-anonymous-default-export": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000"
}
