# Integration Build Configuration
# Focus on external integrations

# Build Type
REACT_APP_BUILD_TYPE=integration

# API Configuration
REACT_APP_API_URL=http://localhost:5000

# Feature Flags
REACT_APP_ENABLE_DEBUG=false
REACT_APP_ENABLE_VERBOSE_LOGGING=false
REACT_APP_ENABLE_REDUX_DEVTOOLS=false
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true
REACT_APP_ENABLE_ERROR_BOUNDARY=true

# Build Configuration
GENERATE_SOURCEMAP=true
INLINE_RUNTIME_CHUNK=true
IMAGE_INLINE_SIZE_LIMIT=10240

# Integration Features
REACT_APP_ENABLE_API_LOGGING=true
REACT_APP_ENABLE_NETWORK_LOGGING=true
REACT_APP_LOG_API_REQUESTS=true
REACT_APP_LOG_API_RESPONSES=true
REACT_APP_SHOW_API_ERRORS=true
REACT_APP_LOG_LEVEL=info
