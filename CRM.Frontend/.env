# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================
# This file is for LOCAL DEVELOPMENT ONLY and is NOT committed to source control.
# For production builds, see .env.production (which MUST have REACT_APP_API_URL empty)
#
# To override these settings locally, create a .env.local file (also ignored by git).
# ============================================================================

# API Base URL - for local development
# This is ONLY used when running 'npm start' locally
# Production builds use .env.production which has this EMPTY for runtime detection
REACT_APP_API_URL=http://localhost:5000/api

# Environment type
NODE_ENV=development

# Dev server config
DANGEROUSLY_DISABLE_HOST_CHECK=true

# OAuth Configuration (Optional - for OAuth login/signup)
# Get these from Google Cloud Console and Azure Portal
# Leave blank to disable OAuth and use only email/password login
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=
REACT_APP_MICROSOFT_TENANT_ID=