# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: This file is committed to source control and used for ALL production builds.
# DO NOT add hardcoded URLs, IPs, or environment-specific values here.
#
# API URL BEHAVIOR:
# - When REACT_APP_API_URL is EMPTY, the frontend auto-detects the API URL
#   using window.location.origin (e.g., https://myapp.com/api)
# - This allows the same build to work on ANY deployment (Azure, AWS, on-prem, etc.)
# - The nginx proxy handles routing /api/* requests to the backend service
#
# NEVER set REACT_APP_API_URL to a specific host here. Use .env.local for local overrides.
# ============================================================================

# Leave empty for runtime detection - DO NOT CHANGE
REACT_APP_API_URL=

# Build mode
NODE_ENV=production

# OAuth - Leave empty unless using OAuth in production
REACT_APP_GOOGLE_CLIENT_ID=
REACT_APP_MICROSOFT_CLIENT_ID=
REACT_APP_MICROSOFT_TENANT_ID=
