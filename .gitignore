# Local development environment config (user-specific)
LOCAL_DEVELOPMENT_ENVIRONMENT.md
# GitHub Copilot helper instructions (workspace-specific, auto-generated)
.github/copilot-instructions.md
# Documentation folder (local specs, guides, and internal docs — not tracked in repo)
docs/
# Git configuration for CRM project
[core]
    ignorecase = true

# Files to ignore
*.dll
*.exe
*.pdb

# Build output directories (in project subdirectories)
**/bin/
**/obj/

# Keep root bin/ and builds/ directories structure
!/bin/
!/bin/README.md
!/bin/*/.gitkeep
bin/**/*.tar.gz
bin/**/*.zip
bin/**/api/
bin/**/frontend/

!/builds/
!/builds/README.md
!/builds/*/.gitkeep
builds/**/backend/
builds/**/frontend/
builds/**/release/

.vs/
.vscode/
node_modules/
dist/
build/
*.log
*.user
*.suo
.DS_Store
# Environment files - IMPORTANT:
# - .env and .env.local are ignored (local overrides)
# - .env.production SHOULD be tracked (contains empty REACT_APP_API_URL for runtime detection)
# - .env.example SHOULD be tracked (template for developers)
.env
.env.local
.env.*.local
!.env.production
!.env.example
!CRM.Frontend/.env.production
!CRM.Frontend/.env.example
appsettings.*.json
!appsettings.json
.docker-remote-config.json

# Build system
.build-cache/
scripts/build/build-config.local.env
/tmp/crm-build-logs/
*.build.log

# Large binary files - use Git LFS or exclude
artifacts/**/*.tar.gz
artifacts/**/api/CRM.Api
artifacts/**/*.so
database/master_data/002_geonames_zipcodes.sql
database/master_data/allCountries.txt
database/master_data/allCountries.zip
*.tar.gz

# Test coverage reports
coverage/
*.lcov
.nyc_output/

# E2E test artifacts and logs
e2e-tests/test-results/
e2e-tests/test-logs/

# Local configuration files (secrets, OAuth credentials)
# These should NEVER be committed to source control
config/*.local.env
config/*.local.json
*.local.env

# SSL certificates - never commit private keys
*.pfx
*.p12
ssl/

# Docker environment files with secrets
docker/.env
docker/.env.*
!docker/.env.example
e2e-tests/job-logs.txt

# Personal writeups - not for repo
docs/VIBE_CODING_JOURNEY.md
docs/DEVELOPMENT_NARRATIVE.md
logs/
local-secrets/
DEVELOPMENT_TEAM_PERSONAS_WEEKLY_ANALYSIS.md

# Build logs - explicit patterns for CI/development builds
buildlog*.txt
*.build.log
build_result.log

# Generated environment files with potential secrets
.env.generated

# Deployment tool generated configs — contain actual passwords, never commit
CRM.Infrastructure/deployment-tool/generated/

# Infrastructure configuration (contains local overrides)
config/infrastructure.env

# IDE and editor workspace-specific config (user settings)
.idea/
*.code-workspace
.vscode/settings.json
.vscode/extensions.json

# AI/LLM generated files or caches
.continuation/
.copilot/
.chatgpt-cache/
.claude-cache/

# Backup files from editors
*.swp
*.swo
*~
*.bak

# Platform-specific files
Thumbs.db
.AppleDouble
.LSOverride

# Gradle/Maven
.gradle/
target/

# Python artifacts (from admin scripts)
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Copilot/AI helper scripts (commit message writers, temp file generators)
write_commit_msg.py
commit_msg.txt
check_hotspots.py
