# CRM Solution - E2E Test Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# This file is committed to git. .env is in .gitignore (never commit secrets).
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#
# Note: Install dotenv to auto-load this file in playwright.config.ts:
#   npm install --save-dev dotenv
#
# Without dotenv you can set variables before running tests:
#   BASE_URL=http://192.168.0.9 npx playwright test

# ── API & Frontend ──────────────────────────────────────────────────────────────

# Base URL for the CRM frontend (nginx, port 80 or 3000)
BASE_URL=http://localhost:5000

# Base URL for the API (dotnet, port 5000)
API_URL=http://localhost:5000

# Base URL for the Customer Portal (if served on a separate port)
PORTAL_URL=http://localhost:3001

# ── Admin credentials ──────────────────────────────────────────────────────────

ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=Admin@123

# ── Portal test user ──────────────────────────────────────────────────────────

PORTAL_EMAIL=portaltest@example.com
PORTAL_PASSWORD=Test@123456

# ── CI settings ───────────────────────────────────────────────────────────────

# Set to any value to enable CI mode (single worker, more retries)
CI=

# ── Dev server ────────────────────────────────────────────────────────────────

# Uncomment to run against the development server
# BASE_URL=http://192.168.0.9
# API_URL=http://192.168.0.9:5000
