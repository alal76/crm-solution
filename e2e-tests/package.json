{
  "name": "crm-e2e-tests",
  "version": "1.0.0",
  "description": "CRM Solution - End-to-End Test Suite",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:bvt": "playwright test --config=playwright.bvt.config.ts",
    "test:auth": "playwright test tests/auth/",
    "test:customers": "playwright test tests/customers/",
    "test:contacts": "playwright test tests/contacts/",
    "test:opportunities": "playwright test tests/opportunities/",
    "test:leads": "playwright test tests/leads/",
    "test:service-requests": "playwright test tests/service-requests/",
    "test:campaigns": "playwright test tests/campaigns/",
    "test:workflows": "playwright test tests/workflows/",
    "test:admin": "playwright test tests/admin/",
    "test:dashboard": "playwright test tests/dashboard/",
    "test:pages": "playwright test tests/full-page-coverage.spec.ts",
    "test:crud": "playwright test tests/crud/",
    "test:crud:accounts": "playwright test tests/crud/crud-accounts.spec.ts",
    "test:crud:contacts": "playwright test tests/crud/crud-contacts.spec.ts",
    "test:crud:opportunities": "playwright test tests/crud/crud-opportunities-leads.spec.ts",
    "test:crud:sales": "playwright test tests/crud/crud-sales-quotes-orders.spec.ts tests/crud/crud-sales-invoices-payments-contracts.spec.ts tests/crud/crud-sales-subscriptions-products.spec.ts",
    "test:crud:marketing": "playwright test tests/crud/crud-marketing.spec.ts",
    "test:crud:service-requests": "playwright test tests/crud/crud-service-requests.spec.ts",
    "test:crud:itsm": "playwright test tests/crud/crud-itsm.spec.ts",
    "test:admin:config": "playwright test tests/admin/admin-config.spec.ts",
    "test:admin:workflows": "playwright test tests/admin/workflows-and-rules.spec.ts",
    "test:admin:agents": "playwright test tests/admin/agents-and-llm.spec.ts",
    "test:admin:workflows-and-agents": "playwright test tests/admin/workflows-and-rules.spec.ts tests/admin/agents-and-llm.spec.ts",
    "test:comprehensive": "playwright test --config=playwright.comprehensive.config.ts tests/full-page-coverage.spec.ts tests/crud/ tests/admin/admin-config.spec.ts tests/admin/workflows-and-rules.spec.ts tests/admin/agents-and-llm.spec.ts",
    "test:comprehensive:headed": "playwright test --config=playwright.comprehensive.config.ts --headed tests/full-page-coverage.spec.ts tests/crud/ tests/admin/admin-config.spec.ts tests/admin/workflows-and-rules.spec.ts tests/admin/agents-and-llm.spec.ts",
    "test:itsm": "playwright test tests/itsm/ tests/crud/crud-itsm.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.19.30",
    "bcryptjs": "^3.0.3"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "crm"
  ],
  "author": "CRM Solution QA Team",
  "license": "SEE LICENSE IN LICENSE"
}
