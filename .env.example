# =============================================================================
# CRM Solution - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to version control!
# 
# Usage:
#   cp .env.example .env
#   # Edit .env with your values (or use build script which auto-generates secrets)
#   export $(cat .env | grep -v '^#' | grep -v '^$' | xargs)
#   docker compose -f docker/docker-compose.microservices.unified.yml up -d
# =============================================================================

# ===========================================
# RUNTIME ENVIRONMENT
# ===========================================
# Set to Development for local dev (enables Quick Admin Login, detailed errors)
# Set to Production for production deployments (security hardened)
ASPNETCORE_ENVIRONMENT=Production

# ===========================================
# JWT AUTHENTICATION (REQUIRED)
# ===========================================
# JWT signing key - MUST be at least 32 characters
# Auto-generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_TO_SECURE_KEY_AT_LEAST_32_CHARS
JWT_SECRET=${JWT_KEY}
JWT_ISSUER=CRM.Api
JWT_AUDIENCE=CRM.Client

# ===========================================
# DATABASE CONFIGURATION (REQUIRED)
# ===========================================
# MariaDB database settings
DB_HOST=crm-db
DB_PORT=3306
DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# External port mapping (host:container)
PORT_MARIADB_EXTERNAL=3306

# ===========================================
# REDIS CACHE CONFIGURATION
# ===========================================
REDIS_HOST=crm-redis
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# ===========================================
# ADMIN USER SEEDING (REQUIRED FOR FIRST RUN)
# ===========================================
# These values are used to seed the initial admin user on first deployment
# Email is optional - if empty, defaults to admin@crm.local
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Administrator

# ===========================================
# DOCKER CONTAINER NAMING
# ===========================================
# Container names - change if running multiple instances
CONTAINER_DB=crm-db
CONTAINER_REDIS=crm-redis
CONTAINER_GATEWAY=crm-gateway
CONTAINER_IDENTITY=crm-identity
CONTAINER_CUSTOMER=crm-customer
CONTAINER_SALES=crm-sales
CONTAINER_MARKETING=crm-marketing
CONTAINER_SERVICEDESK=crm-servicedesk
CONTAINER_CORE=crm-core
CONTAINER_FRONTEND=crm-frontend

# ===========================================
# DOCKER NETWORK CONFIGURATION
# ===========================================
DOCKER_NETWORK_NAME=crm-network
DOCKER_NETWORK_SUBNET=172.28.0.0/16

# ===========================================
# SERVICE PORTS (CONTAINER INTERNAL)
# ===========================================
PORT_GATEWAY=5000
PORT_IDENTITY=5001
PORT_CUSTOMER=5002
PORT_SALES=5003
PORT_MARKETING=5004
PORT_SERVICEDESK=5005
PORT_CORE=5006
FRONTEND_PORT=80

# ===========================================
# DOCKER IMAGE VERSIONS
# ===========================================
MS_VERSION=latest
IMAGE_MARIADB=mariadb:10.11
IMAGE_REDIS=redis:7-alpine

# ===========================================
# CORS / ALLOWED ORIGINS
# ===========================================
# Comma-separated list of allowed origins for CORS
# Include your domain(s) for production
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5000

# ===========================================
# DEPLOYMENT CONFIGURATION
# ===========================================
# Target server for remote deployment
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PATH=/opt/crm-solution
DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Architecture mode: monolith or microservices
ARCHITECTURE_MODE=microservices

# ===========================================
# LLM/AI PROVIDER CONFIGURATION (Optional)
# ===========================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google AI
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-pro

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Allen AI
ALLENAI_API_KEY=
ALLENAI_MODEL=OLMo-2-0325-32B-Instruct

# Local LLM (Ollama)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2

# Default AI Provider (openai, azure, anthropic, google, deepseek, allenai, local)
DEFAULT_AI_PROVIDER=openai

# ===========================================
# OAUTH PROVIDERS (Optional)
# ===========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=CRM System

# ===========================================
# LOGGING & MONITORING (Optional)
# ===========================================
LOG_LEVEL=Information
ENABLE_REQUEST_LOGGING=false
ENABLE_SQL_LOGGING=false

# ===========================================
# FEATURE FLAGS (Optional)
# ===========================================
# Enable/disable quick admin login button on login page (only works in Development env)
QUICK_ADMIN_LOGIN_ENABLED=true

# Enable sample data seeding on startup
SEED_SAMPLE_DATA=false

# ===========================================
# APACHE SUPERSET (Analytics Provider)
# Deployed via docker/docker-compose.superset.yml
# ===========================================
SUPERSET_SECRET_KEY=changeme-superset-secret-32chars-min
SUPERSET_DB_PASSWORD=changeme-superset-db-password
SUPERSET_ADMIN_PASSWORD=SupersetAdmin2026
SUPERSET_GUEST_TOKEN_SECRET=changeme-guest-token-secret
