# ============================================================================
# CRM Frontend - Pre-built Production Image
# ============================================================================
# This Dockerfile uses a pre-built React app with nginx for serving and API proxying.
#
# IMPORTANT: Before building this image, ensure:
# 1. Run 'npm run build' in CRM.Frontend with .env.production having REACT_APP_API_URL=
# 2. The build directory contains no hardcoded URLs (run scripts/validate-build.sh)
#
# The frontend auto-detects the API URL at runtime using window.location.origin.
# nginx proxies /api/* requests to the backend service (crm-api:5000).
# ============================================================================

FROM nginx:alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy nginx configuration with API proxy settings
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Copy pre-built app directly to nginx html directory
COPY CRM.Frontend/build /usr/share/nginx/html

# Validate the build doesn't contain hardcoded URLs
RUN echo "Validating pre-built assets..." && \
    if grep -rE 'localhost:[0-9]{4}' /usr/share/nginx/html/static/js/*.js 2>/dev/null | grep -v '//' | head -1; then \
        echo "ERROR: Found hardcoded localhost URLs in bundle" && exit 1; \
    fi && \
    if grep -rE '192\.168\.[0-9]+\.[0-9]+:[0-9]+' /usr/share/nginx/html/static/js/*.js 2>/dev/null | head -1; then \
        echo "ERROR: Found hardcoded private IPs in bundle" && exit 1; \
    fi && \
    echo "Build validation passed"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

# Expose the port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
