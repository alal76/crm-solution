# ============================================================================
# CRM Frontend - Pre-built Production Image
# ============================================================================
# This Dockerfile uses a pre-built React app with nginx for serving and API proxying.
#
# IMPORTANT: Before building this image, ensure:
# 1. Run 'npm run build' in CRM.Frontend with .env.production having REACT_APP_API_URL=
# 2. The build directory contains no hardcoded URLs (run scripts/validate-build.sh)
#
# The frontend auto-detects the API URL at runtime using window.location.origin.
# nginx proxies /api/* requests to the backend service (crm-api:5000).
# ============================================================================

FROM nginx:alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy nginx configuration with API proxy settings
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Copy pre-built app directly to nginx html directory
COPY CRM.Frontend/build /usr/share/nginx/html

# Validate the build doesn't contain hardcoded CRM API URLs
# Note: We check for fetch/axios calls to localhost, not template strings
# Legitimate localhost URLs (like Ollama at :11434, UI placeholders) are allowed
RUN echo "Validating pre-built assets..." && \
    MATCHES=$(grep -c 'fetch.*localhost:5000/api\|axios.*localhost:5000/api' /usr/share/nginx/html/static/js/*.js 2>/dev/null | grep -v ':0$' | head -1) && \
    if [ -n "$MATCHES" ]; then \
        echo "ERROR: Found hardcoded localhost:5000 API calls in bundle: $MATCHES" && exit 1; \
    fi && \
    echo "Build validation passed - no hardcoded API calls found"

# Health check (use 127.0.0.1 not localhost - Alpine resolves localhost to IPv6 ::1 first, but nginx listens on IPv4 only)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:80/health || exit 1

# Expose the port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
