# syntax=docker/dockerfile:1.4
# =============================================================================
# CRM Backend - Optimized Multi-Stage Dockerfile
# =============================================================================
# Features:
#   - Layer caching for faster rebuilds
#   - Separate restore and build stages
#   - Minimal runtime image
# =============================================================================

# ============================================
# Stage 1: Build (restore + compile)
# ============================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder

WORKDIR /src

# Copy only project files first for layer caching
# Copy solution file from CRM.Backend directory (context is workspace root)
COPY CRM.Backend/CRM.sln ./
COPY CRM.Backend/src/CRM.Core/CRM.Core.csproj ./src/CRM.Core/
COPY CRM.Backend/src/CRM.Infrastructure/CRM.Infrastructure.csproj ./src/CRM.Infrastructure/
COPY CRM.Backend/src/CRM.Api/CRM.Api.csproj ./src/CRM.Api/
COPY CRM.Backend/src/CRM.DatabaseSeeder/CRM.DatabaseSeeder.csproj ./src/CRM.DatabaseSeeder/
COPY CRM.Backend/tests/CRM.Tests.csproj ./tests/
COPY CRM.Backend/tests/CRM.Tests/CRM.Tests.csproj ./tests/CRM.Tests/
COPY CRM.Backend/tests/CRM.SystemModule.Tests/CRM.SystemModule.Tests.csproj ./tests/CRM.SystemModule.Tests/
COPY CRM.Backend/tests/Unit/Core/CRM.Tests.Unit.Core.csproj ./tests/Unit/Core/
COPY CRM.Backend/tests/Unit/CRM.Tests.Unit.csproj ./tests/Unit/

# Restore dependencies (this layer is cached unless project files change)
RUN dotnet restore CRM.sln

# Copy all source files
COPY CRM.Backend/src/ ./src/

# Include help documentation in the image for offline/AI help
COPY docs/help/ ./docs/help/

# Build and publish (only the API project, skip tests)
RUN dotnet publish "src/CRM.Api/CRM.Api.csproj" -c Release -o /app/publish

# ============================================
# Stage 2: Runtime (minimal image)
# ============================================
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS runtime


WORKDIR /app


# Install minimal dependencies including ICU for globalization and dotnet-ef for migrations
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    dotnet tool install --global dotnet-ef && \
    export PATH="$PATH:/root/.dotnet/tools" && \
    rm -rf /var/lib/apt/lists/*

# Create directories with proper permissions
RUN mkdir -p /app/data /app/ssl /app/wwwroot/uploads/logos /app/wwwroot/uploads/users /app/wwwroot/uploads/customers /app/wwwroot/uploads/contacts && \
    chmod 755 /app/data && \
    chmod -R 755 /app/wwwroot && \
    chmod 755 /app/ssl

# Copy published application
COPY --from=builder /app/publish .

# Copy version.json into the image for runtime version detection
COPY version.json /app/version.json

# Copy help docs into runtime image
COPY --from=builder /src/docs/help /app/docs/help

# Note: SSL certificate should be mounted via Kubernetes secret, not baked into image
# Example K8s volume mount: /app/ssl/server.pfx

# Create startup script
RUN printf '#!/bin/sh\nset -e\necho "Starting CRM API..."\nexport PATH="$PATH:/root/.dotnet/tools"\nif [ -f /app/ssl/server.pfx ]; then\n  echo "SSL certificate found - HTTPS on port 5001"\nelse\n  echo "No SSL - HTTP only on port 5000"\nfi\nexec "$@"\n' > /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1


EXPOSE 5000 5001


# SECURITY: SSL_CERT_PASSWORD must be provided at runtime via environment variable.
# Do NOT bake passwords into the image. Mount the certificate via K8s secret or Docker volume.
ARG SSL_CERT_PASSWORD=""


# Environment configuration
ENV ASPNETCORE_URLS=http://+:5000 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    SSL_CERT_PATH=/app/ssl/server.pfx \
    SSL_CERT_PASSWORD=${SSL_CERT_PASSWORD} \
    HTTPS_PORT=5001 \
    HTTP_PORT=5000 \
    PATH="/root/.dotnet/tools:$PATH"


ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["dotnet", "CRM.Api.dll"]
